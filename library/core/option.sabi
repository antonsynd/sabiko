//! `Option<T>`, Rust's `core::option::Option`: a value of type `T`, or none.
//!
//! Part of the `core` prelude (decision 90): `Option`, `Some` and `None` are visible in
//! every program, and a user item of the same name shadows them. The methods keep Rust's
//! names and panic messages, so a program using them is valid Rust too.

/// `Some(value)`, or `None`.
#[derive(Copy, Clone)]
pub enum Option<T> {
    /// No value.
    None,
    /// Some value of type `T`.
    Some(T),
}

pub use Option::{None, Some};

impl<T> Option<T> {
    /// Whether the option is a `Some` value.
    pub fn is_some(&self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    /// Whether the option is a `None` value.
    pub fn is_none(&self) -> bool {
        !self.is_some()
    }

    /// The `Some` value; panics with `msg` on `None`.
    #[track_caller]
    pub fn expect(self, msg: &str) -> T {
        match self {
            Some(val) => val,
            None => Panic(msg),
        }
    }

    /// The `Some` value; panics on `None`.
    #[track_caller]
    pub fn unwrap(self) -> T {
        match self {
            Some(val) => val,
            None => Panic("called `Option::unwrap()` on a `None` value"),
        }
    }

    /// The `Some` value, or `default`.
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Some(x) => x,
            None => default,
        }
    }
}
