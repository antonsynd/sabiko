//! `From` and `Into`, Rust's `core::convert` traits for conversions that cannot fail,
//! with the implementations of Rust's standard library that Sabiko's types allow
//! (decision 95).
//!
//! Part of the `core` prelude (decision 90): `From` and `Into` are visible in every
//! program, and a user item of the same name shadows them. `e?` converts a `Result`'s
//! error with `From::from`. A program implements `From` for its own types; `Into` comes
//! with it, through the blanket implementation below.

/// A conversion from a `T` into `Self`, which cannot fail.
pub trait From<T> {
    /// Converts `value` into a `Self`.
    fn from(value: T) -> Self;
}

/// A conversion of `Self` into a `T`, which cannot fail: implement `From` instead, which
/// gives this one.
pub trait Into<T> {
    /// Converts the value into a `T`.
    fn into(self) -> T;
}

/// Every type converts from itself.
impl<T> From<T> for T {
    fn from(t: T) -> T {
        t
    }
}

/// `Into` is `From` the other way round.
impl<T, U> Into<U> for T
where
    U: From<T>,
{
    fn into(self) -> U {
        U::from(self)
    }
}

/// A value converts into `Some` of it.
impl<T> From<T> for Option<T> {
    fn from(val: T) -> Option<T> {
        Some(val)
    }
}

// Region model of a header (decision 95): every reference a prelude header writes
// shares one region, as if the header named one lifetime in all of them; std writes
// these two blocks `impl<'a, T> From<&'a Option<T>> for Option<&'a T>` (and `&'a mut`).
// Read as Rust, elided references in a header would be distinct lifetimes: a new block
// with references must name one lifetime in each, which
// `crates/sabiko_driver/tests/prelude_impl_headers.rs` checks.

/// A reference to an option converts into an option of a reference to its value.
impl<T> From<&Option<T>> for Option<&T> {
    fn from(o: &Option<T>) -> Option<&T> {
        o.as_ref()
    }
}

/// A mutable reference to an option converts into an option of a mutable reference to
/// its value.
impl<T> From<&mut Option<T>> for Option<&mut T> {
    fn from(o: &mut Option<T>) -> Option<&mut T> {
        o.as_mut()
    }
}

// The lossless conversions between primitive types.

impl From<bool> for i8 {
    fn from(small: bool) -> i8 {
        small as i8
    }
}

impl From<bool> for i16 {
    fn from(small: bool) -> i16 {
        small as i16
    }
}

