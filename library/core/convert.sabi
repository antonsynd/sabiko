// Arrays of up to 12 elements and tuples of as many elements of one type, both ways. An
// array into a tuple needs array patterns: its body is an intrinsic that is not yet
// compiled (E0500 where a program reaches it).

#[intrinsic]
fn ArrayIntoTuple<A, T>(array: A) -> T {
    loop {}
}

impl<T> From<[T; 1]> for (T,) {
    fn from(array: [T; 1]) -> (T,) {
        ArrayIntoTuple(array)
    }
}

impl<T> From<(T,)> for [T; 1] {
    fn from(tuple: (T,)) -> [T; 1] {
        let (e0,) = tuple;
        [e0]
    }
}

impl<T> From<[T; 2]> for (T, T) {
    fn from(array: [T; 2]) -> (T, T) {
        ArrayIntoTuple(array)
    }
}

impl<T> From<(T, T)> for [T; 2] {
    fn from(tuple: (T, T)) -> [T; 2] {
        let (e0, e1) = tuple;
        [e0, e1]
    }
}

impl<T> From<[T; 3]> for (T, T, T) {
    fn from(array: [T; 3]) -> (T, T, T) {
        ArrayIntoTuple(array)
    }
}

impl<T> From<(T, T, T)> for [T; 3] {
    fn from(tuple: (T, T, T)) -> [T; 3] {
        let (e0, e1, e2) = tuple;
        [e0, e1, e2]
    }
}

impl<T> From<[T; 4]> for (T, T, T, T) {
    fn from(array: [T; 4]) -> (T, T, T, T) {
