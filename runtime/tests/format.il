// Runtime formatting regression probe: every Sabiko.Runtime.Console overload, with the values
// a differential test is most likely to trip over (shortest round-trip floats, no exponents,
// -0, NaN/inf, integer extremes, lowercase bools, UTF-8 strings).
//
// format.expected was generated by rustc from the equivalent Rust program (one `println!("{}", v)`
// per call below, `print!` for the Print calls); Sabiko output must be byte-identical to it.
// Run scripts/check-runtime.sh.
.assembly extern System.Runtime { .ver 10:0:0:0 .publickeytoken = (B0 3F 5F 7F 11 D5 0A 3A) }
.assembly extern Sabiko.Runtime { .ver 0:1:0:0 }
.assembly Format { .ver 0:1:0:0 }
.module Format.exe

