// Constant evaluation as MIR prints it: `bool` operators, tuple constants of one and two
// elements, associated constants of `char` and the float types, and a left shift of a
// negative value (sign extension back from the unsigned domain).
const ORS: (bool, bool, bool) = (true | true, true || false, false | false);
const XOR: bool = true ^ true;
const ONE: (i32,) = (7,);
const TWO: (i32, bool) = (2, false);
const SECOND: bool = TWO.1;
const REPLACEMENT: char = char::REPLACEMENT_CHARACTER;
const EPS: f64 = f64::EPSILON;
const BIG: f32 = f32::MAX;
const SHIFTED: i8 = -1 << 3;

fn Main() {
    let ors = ORS;
    let xor = XOR;
    let one = ONE;
    let two = TWO;
    let second = SECOND;
    let c = REPLACEMENT;
    let e = EPS;
    let b = BIG;
    let s = SHIFTED;
}
