// Trait constants (#116): in a generic function, `T::N` stays unevaluated, printed as
// `<T as Trait>::N`; monomorphisation evaluates it at each instance. A function that is
// not generic gets the value of `S::N` when its MIR is built.
trait Shape {
    const SIDES: u32;
    const DOUBLE: u32 = Self::SIDES * 2;
}

struct Square;

impl Shape for Square {
    const SIDES: u32 = 4;
}

impl Shape for u8 {
    const SIDES: u32 = 1;
    const DOUBLE: u32 = 7;
}

fn Corners<T: Shape>() -> u32 {
    T::SIDES + T::DOUBLE
}

fn Main() {
    let a = Corners::<Square>() + Corners::<u8>();
    let b = Square::DOUBLE;
}
