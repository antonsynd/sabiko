// `e?` (decision 93): the operand goes into a temporary of the statement, its
// discriminant is tested, and either the `Some`/`Ok` value moves out of it, or the
// function returns `None`/`Err` with the error moved out, dropping the live locals on the
// way. A slice method of the prelude called on an array borrows the array and unsizes the
// borrow to a slice.
struct D {
    N: i32,
}

impl Drop for D {
    fn drop(&mut self) {}
}

fn Half(x: i32) -> Option<i32> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

fn Quarter(x: i32) -> Option<i32> {
    let _d = D { N: x };
    let h = Half(x)?;
    Some(h / 2)
}

fn Checked(r: Result<D, u8>) -> Result<i32, u8> {
    let d = r?;
    Ok(d.N)
}

fn Second(a: [i32; 3]) -> Option<i32> {
    Some(*a.get(1)?)
}

fn Main() {
    PrintLine(Quarter(8).unwrap_or(0));
    PrintLine(Checked(Err(1)).is_err());
    PrintLine(Second([1, 2, 3]).unwrap_or(0));
}
