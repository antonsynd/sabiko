// Block and stack shapes the corpora did not reach, found by mutation testing: a block
// that only returns but is a branch target keeps its own `ret` (`Pick`); a value computed
// before a division known to panic still goes to its own local (`Weigh`); and an
// assignment to the return place followed by a drop flag write is stored, not left on the
// stack, since the flag write comes before the return (`Make`). Found by the first nightly
// run with a correct timeout: borrowing an element of `()` checks the index for the
// mention and again for the borrow itself (`UnitAt`), and a sub-slice's order check is
// left out when the start is 0 or both bounds are constants in order, exclusive or
// inclusive (`Spans`).
struct Guard {
    A: i32,
}

impl Drop for Guard {
    fn drop(&mut self) {}
}

fn Pick(g: Guard, c: bool) {
    let n = if c { g } else { Guard { A: 1 } };
    if c {}
}

fn Weigh(c: bool, x: u8) {
    PrintLine(if c { 3u8 } else { (x / 10u8) % 0u8 });
}

fn Make(c: bool, x: i32) -> (i32, Guard) {
    let g = if c { Guard { A: x } } else { Guard { A: x + x } };
    (x + 1, g)
}

fn UnitAt(a: &[(); 3], i: usize) -> &() {
    &a[i]
}

fn Spans(a: &[i32], n: usize) -> usize {
    a[0..n].len() + a[0..].len() + a[1..3].len() + a[2..=2].len()
}

// Found by nightly run 26 (#142): a local used once as a whole and also as a sub-slice
// bound is stored at its definition, not taken from the stack by its one whole use and then
// duplicated for the bound's two reads (`BoundAndUse`); and a local that is never written
// (its only assignment is unreachable) gets no IL local, so its type `[i64; 3]` is not
// declared either (`Unreached`).
fn BoundAndUse(a: &[i32], n: usize) -> usize {
    let m = n + 1;
    PrintLine(m);
    a[0..m].len()
}

fn Unreached() -> i64 {
    let a: [i64; 3] = return 1;
    a[0]
}
