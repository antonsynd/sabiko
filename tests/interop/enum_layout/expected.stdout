== layout
Color (sequential struct) { Tag: System.Int32 }
Code (sequential struct) { Tag: System.Int64 }
Token (sequential struct) { Tag_: System.Int32, Value: Token+ValuePayload }
  Token+ValuePayload (sequential struct) { Item1: System.Int32 }
Wrapper (sequential struct) { Tag: System.Int32, Item: Wrapper+ItemPayload_, ItemPayload: Wrapper+ItemPayloadPayload }
  Wrapper+ItemPayload_ (sequential struct) { Item1: System.Int32 }
  Wrapper+ItemPayloadPayload (sequential struct) { Item1: System.Boolean }
Point (sequential struct) { X: System.Int32, Y: System.Int32 }
Shape (sequential struct) { Tag: System.Int32, Circle: Shape+CirclePayload, Rect: Shape+RectPayload, Line: Shape+LinePayload }
  Shape+CirclePayload (sequential struct) { Item1: System.Double }
  Shape+RectPayload (sequential struct) { W: System.Int32, H: System.Int32 }
  Shape+LinePayload (sequential struct) { Item1: Point, Item2: Point }
Event (sequential struct) { Tag: System.Int32, Click: Event+ClickPayload, Key: Event+KeyPayload, Draw: Event+DrawPayload }
  Event+ClickPayload (sequential struct) { Item1: Point }
  Event+KeyPayload (sequential struct) { Code: Code, Shift: System.Boolean }
  Event+DrawPayload (sequential struct) { Item1: Shape, Item2: Color }
