// Each call instantiates `Grow` at a larger type, so monomorphisation never ends: it stops
// at the recursion limit, as rustc does.

fn Grow<T>(x: T, n: i32) {
    if n > 0 {
        Grow((x,), n - 1); //~ ERROR E0502 reached the recursion limit while instantiating
    }
}

fn Main() {
    Grow(1, 3);
}

// Doubling the type at each step reaches the type-length limit long before the depth one.
fn Double<T>(x: T, n: i32) {
    if n > 0 {
        Double((&x, &x), n - 1); //~ ERROR E0502 reached the type-length limit while instantiating `Double`
    }
}

fn Start() {
    Double(1, 3);
}

// The prelude's types are named as the program names them, not as generated code does
// (`core::Option`, decision 90).
fn Wrap<T>(x: T, n: i32) {
    if n > 0 {
        Wrap(Some(x), n - 1); //~ ERROR E0502 reached the recursion limit while instantiating `Wrap<Option<Option<
    }
}

fn Begin() {
    Wrap(1, 3);
}
