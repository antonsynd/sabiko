// References that outlive their referent: a local of an inner block or a loop body, and
// data owned by the function being returned.
struct Point {
    X: i32,
    Y: i32,
}

fn InnerBlock() {
    let r;
    {
        let x = 1;
        r = &x; //~ ERROR E0413 `x` does not live long enough
    }
    let _ = *r;
}

fn LoopBody() {
    let zero = 0;
    let mut s = &zero;
    let mut i = 0;
    while i < 3 {
        let y = i;
        s = &y; //~ ERROR E0413 `y` does not live long enough
        i += 1;
    }
    let _ = *s;
}

fn ReturnLocal(p: &i32) -> &i32 {
    let x = *p;
    &x //~ ERROR E0414 cannot return reference to local variable `x`
}

fn ReturnLocalField(p: &i32) -> &i32 {
    let q = Point { X: *p, Y: 0 };
    &q.X //~ ERROR E0414 cannot return reference to local data `q.X`
}

fn ReturnParameterField(p: Point, q: &i32) -> &i32 {
    let _ = q;
    &p.X //~ ERROR E0414 cannot return reference to local data `p.X`
}

fn EarlyReturnLocal(p: &i32) -> &i32 {
    if *p > 0 {
        let x = 1;
        return &x; //~ ERROR E0414 cannot return reference to local variable `x`
    }
    p
}

fn ReturnParameterDataIsFine(p: &Point) -> &i32 {
    let q = p;
    &q.X
}
