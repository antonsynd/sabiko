// Moving a non-Copy value out from behind a reference, whole or by field. Copying a
// `Copy` field out is fine.
struct P {
    X: i32,
}

struct Pair {
    A: P,
    B: P,
}

fn Take(p: P) {}

fn Read(n: i32) {}

fn Shared(r: &P) {
    let p = *r; //~ ERROR E0407 cannot move out of `*r` which is behind a shared reference
    Read(r.X);
}

fn Mutable(r: &mut P) {
    Take(*r); //~ ERROR E0407 cannot move out of `*r` which is behind a mutable reference
}

fn Field(pair: &Pair) {
    let a = pair.A; //~ ERROR E0407 cannot move out of `pair.A` which is behind a shared reference
    Read(pair.B.X);
}

fn FieldMut(pair: &mut Pair) {
    Take(pair.B); //~ ERROR E0407 cannot move out of `pair.B` which is behind a mutable reference
}
