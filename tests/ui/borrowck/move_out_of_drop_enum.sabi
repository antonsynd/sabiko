// (drops, #12) An enum with its own `Drop` impl cannot have a non-Copy payload moved out
// by a match binding (E0509, like a struct with `Drop`); `ref` bindings and Copy payloads
// are fine. As in rustc, the error is reported at the scrutinee, once per place moved out of
// (`(h as One)` and `(h as Two)` are two), with a label at each binding that moves (#50).
struct Token { Id: i32 }

enum Holder { Nothing, One(Token), Count(i32), Two(Token, Token) }

impl Drop for Holder {
    fn drop(&mut self) {
        PrintLine("drop holder");
    }
}

fn Consume(t: Token) {}

fn F(h: Holder) -> i32 {
    match h { //~ ERROR E0418 cannot move out of type `Holder`, which implements the `Drop` trait
    //~^ ERROR E0418 cannot move out of type `Holder`, which implements the `Drop` trait
        Holder::One(t) => {
            Consume(t);
            1
        }
        Holder::Count(n) => n,
        Holder::Two(a, b) => a.Id + b.Id,
        Holder::Nothing => 0,
    }
}

fn G(h: Holder) -> i32 {
    match h {
        Holder::One(ref t) => t.Id,
        Holder::Count(n) => n,
        Holder::Two(ref a, _) => a.Id,
        Holder::Nothing => 0,
    }
}

fn H(h: Holder) {
    if let Holder::One(t) = h { //~ ERROR E0418 cannot move out of type `Holder`, which implements the `Drop` trait
        Consume(t);
    }
}

fn K(h: Holder) {
    let Holder::Two(a, _) = h else { return; }; //~ ERROR E0418 cannot move out of type `Holder`, which implements the `Drop` trait
}
