// Every printable type goes through `Print`/`PrintLine`, and `Panic` diverges.
fn Checked(x: i32) -> i32 {
    if x >= 0 { x } else { Panic("negative") }
}

fn Main() {
    let s: &str = "text";
    let b: u8 = 7;
    let f: f32 = 1.5;
    let flag = true;
    let c = 'c';
    PrintLine("text");
    Print(s);
    PrintLine(b);
    Print(f);
    PrintLine(flag);
    Print(c);
    PrintLine(1);
    PrintLine(Checked(3));
}
