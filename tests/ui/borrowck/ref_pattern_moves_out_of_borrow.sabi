// Sabiko codes for rustc's: E0407 for E0507.
// A by-value binding of a non-Copy part under a `&` or `&mut` pattern (#49) moves out of
// the borrow. rustc reports the first at the scrutinee and names the place "`r` as enum
// variant `Full`"; Sabiko reports moves at the binding.
struct Token { Id: i32 }
enum Slot { Empty, Full(Token) }

fn Shared(r: &Slot) -> i32 {
    match r {
        &Slot::Full(t) => t.Id, //~ ERROR E0407 cannot move out of `r.0` which is behind a shared reference
        &Slot::Empty => 0,
    }
}

fn Mutable(r: &mut (Token, i32)) -> i32 {
    let &mut (t, n) = r; //~ ERROR E0407 cannot move out of `r.0` which is behind a mutable reference
    t.Id + n
}

fn Param(&(t, n): &(Token, i32)) -> i32 { //~ ERROR E0407 cannot move out of a shared reference
    t.Id + n
}

fn Main() {}
