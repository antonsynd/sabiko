// Sabiko codes for rustc's: E0419 for E0510.
// Fake borrows: while a guard runs, what the match tests may not be changed, since later
// arms would test a different value. Assigning it or borrowing it mutably in a guard is
// E0510 (differential/loans/err_guard_* compare more cases with rustc). With a binding in the arm,
// rustc reports E0506 instead (differential/loans/err_match_guard_binding_blocks_assignment).
enum Cell { Empty, Value(i32) }

fn Clear(c: &mut Cell) {}

fn F(mut c: Cell) -> i32 {
    match c {
        Cell::Value(_) if { c = Cell::Empty; false } => 1, //~ ERROR E0419 cannot assign `c` in match guard
        Cell::Value(_) if { Clear(&mut c); false } => 2, //~ ERROR E0419 cannot mutably borrow `c` in match guard
        _ => 0,
    }
}
