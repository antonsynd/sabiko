// A gap of the matched-place read (#201, decision 106): rustc accepts this program. The
// guard of an arm that tests something moves part of the scrutinee, so Sabiko reads the
// scrutinee before the tests, where it is still moved from before the match. rustc reads
// it only for the left-out variant, after the last guard, which gives it back.
enum Void {}

struct N { A: i32 }

enum E { A(N), B(Void) }

fn Take(n: N) {}

fn Mv(n: N) -> bool { false }

fn F(mut t: (N, E)) -> i32 {
    Take(t.0);
    match t { //~ ERROR E0406 use of partially moved value: `t`
        (_, E::A(_)) if { t.0 = N { A: 1 }; Mv(t.0) } => 1,
        (_, E::A(_)) => 2,
        (_, _) if { t.0 = N { A: 2 }; false } => 3,
    }
}

fn Main() {}
