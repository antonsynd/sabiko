// Every test a match makes reads the place it tests, at rustc's spans (#150, decision 107):
// an integer, `char` or `bool` comparison at the `match x` (or, for `if let`, `while let`
// and `let`-`else`, at the top-level pattern), a range or float comparison at its own
// sub-pattern, and a test that reuses a value read for an earlier one reads the place
// again, so each conflicting test is reported, once per place and span.
enum E {
    W(Option<i32>),
    V,
}

fn C() -> bool {
    true
}

fn IfLetNested() {
    let mut o = Some(3);
    let q = &mut o;
    if let Some(3) = o {}
    //~^ ERROR E0411 cannot use `o.0` because it was mutably borrowed
    //~^^ ERROR E0411 cannot use `o` because it was mutably borrowed
    *q = None;
}

fn WhileLetNested() {
    let mut e = E::W(Some(1));
    let q = &mut e;
    while let E::W(Some(1)) = e {}
    //~^ ERROR E0411 cannot use `e.0.0` because it was mutably borrowed
    //~^^ ERROR E0411 cannot use `e` because it was mutably borrowed
    //~^^^ ERROR E0411 cannot use `e.0` because it was mutably borrowed
    *q = E::V;
}

fn LetElseNested() {
    let mut t = (1, Some(2));
    let q = &mut t;
    let (1, Some(x)) = t else {
        //~^ ERROR E0411 cannot use `t.0` because it was mutably borrowed
        //~^^ ERROR E0411 cannot use `t.1.0` because it was mutably borrowed
        //~^^^ ERROR E0411 cannot use `t.1` because it was mutably borrowed
        return;
    };
    *q = (0, None);
}

fn ValueThenRange() {
    let mut x = 3;
    let q = &mut x;
    match x {
        //~^ ERROR E0411 cannot use `x` because it was mutably borrowed
        1 | 2..=4 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        _ => {}
    }
    *q = 1;
}

fn TwoOpenRanges() {
    let mut x = 3;
    let q = &mut x;
    match x {
        ..5 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        1.. => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
    }
    *q = 1;
}

fn Values() {
    let mut x = 3;
    let q = &mut x;
    match x { //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        1 => {}
        2 => {}
        _ => {}
    }
    *q = 1;
}

fn ValuesAroundARange() {
    let mut x = 3;
    let q = &mut x;
    match x { //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        1 => {}
        2..=4 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        5 => {}
        _ => {}
    }
    *q = 1;
}

fn TwoRanges() {
    let mut x = 3;
    let q = &mut x;
    match x {
        2..=4 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        5..=6 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        _ => {}
    }
    *q = 1;
}

fn Chars() {
    let mut x = 'c';
    let q = &mut x;
    match x { //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        'a' | 'b' => {}
        'c'..='e' => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        _ => {}
    }
    *q = 'a';
}

fn Bools() {
    let mut x = true;
    let q = &mut x;
    match x { //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        true => {}
        false => {}
    }
    *q = false;
}

fn TupleValues() {
    let mut x = (1, 2);
    let q = &mut x;
    match x {
        //~^ ERROR E0411 cannot use `x.0` because it was mutably borrowed
        //~^^ ERROR E0411 cannot use `x.1` because it was mutably borrowed
        (1, 2) => {}
        (1, 3) => {}
        _ => {}
    }
    *q = (0, 0);
}

fn Floats() {
    let mut x = 1.0;
    let q = &mut x;
    match x {
        1.0 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        2.0 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        _ => {}
    }
    *q = 0.0;
}

fn GuardedValue() {
    let mut x = 3;
    let q = &mut x;
    match x { //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        1 if C() => {}
        2..=4 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        _ => {}
    }
    *q = 1;
}

fn RangesAroundAValue() {
    let mut x = 3;
    let q = &mut x;
    match x { //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        2..=4 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        1 => {}
        7..=8 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        _ => {}
    }
    *q = 1;
}

fn RangeAmongValues() {
    let mut x = 3;
    let q = &mut x;
    match x { //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        1 => {}
        2 => {}
        3..=4 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        9 => {}
        _ => {}
    }
    *q = 1;
}

fn NestedOpenRanges() {
    let mut x = 3;
    let q = &mut x;
    match x {
        ..5 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        ..7 => {} //~ ERROR E0411 cannot use `x` because it was mutably borrowed
        _ => {}
    }
    *q = 1;
}

fn IfLetOrPattern() {
    let mut x = 3;
    let q = &mut x;
    if let 1 | 2..=4 = x {}
    //~^ ERROR E0411 cannot use `x` because it was mutably borrowed
    //~^^ ERROR E0411 cannot use `x` because it was mutably borrowed
    *q = 1;
}

fn TupleRanges() {
    let mut x = (1, 2);
    let q = &mut x;
    match x {
        //~^ ERROR E0411 cannot use `x.0` because it was mutably borrowed
        (1, 2..=3) => {} //~ ERROR E0411 cannot use `x.1` because it was mutably borrowed
        (2, 2..=3) => {} //~ ERROR E0411 cannot use `x.1` because it was mutably borrowed
        _ => {}
    }
    *q = (0, 0);
}
