// `Drop` can only be implemented for a struct (or enum) defined in the program: not for a
// primitive, a tuple or a reference. For the first two rustc also reports the orphan rule
// (E0117: `Drop` is not the program's trait and the type is not its type).
// Checked against rustc: E0117, E0120 (the Sabiko codes are annotated).
struct D { Id: i32 }

impl Drop for i32 { //~ ERROR E0214 the `Drop` trait may only be implemented for structs of this file
    fn drop(&mut self) {}
}

impl Drop for (D, D) { //~ ERROR E0214 the `Drop` trait may only be implemented for structs of this file
    fn drop(&mut self) {}
}

impl Drop for &D { //~ ERROR E0214 the `Drop` trait may only be implemented for structs of this file
    fn drop(&mut self) {}
}
