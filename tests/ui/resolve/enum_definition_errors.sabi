// Sabiko codes for rustc's: E0200 for E0428, E0204 for E0124.
// Enum definitions: variant names are unique within an enum, and an enum shares the item
// namespace with structs and functions (both E0428); a struct variant's field names are
// unique (E0124).
enum Light { Red, Green, Red } //~ ERROR E0200 the name `Red` is defined multiple times

struct Dir { X: i32 }

enum Dir { North } //~ ERROR E0200 the name `Dir` is defined multiple times

enum Shape { Rect { W: i32, W: i32 } } //~ ERROR E0204 field `W` is already declared
