// Sabiko codes for rustc's: E0220 for E0435.
// An array length is a constant expression: a local or a parameter there is E0435
// ("attempt to use a non-constant value in a constant"), in a repeat expression and in a
// type alike. `const` items are fine (run/arrays/const_lengths.sabi).
fn Main() {
    let n = 3;
    let a = [0; n]; //~ ERROR E0220 attempt to use a non-constant value in a constant
    let b: [i32; n] = [1, 2, 3]; //~ ERROR E0220 attempt to use a non-constant value in a constant
}

fn F(len: usize) -> usize {
    let c = [true; len]; //~ ERROR E0220 attempt to use a non-constant value in a constant
    c.len()
}
