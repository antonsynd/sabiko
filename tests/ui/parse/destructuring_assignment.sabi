// `_`, a lone `..` element and a struct literal's trailing `..` are expressions only on
// the left of a destructuring assignment, which reads them as patterns; anywhere else
// they are errors. A tuple or tuple-variant pattern takes one `..`, in a `let` too, and
// an array on the left of `=` would need slice patterns.
struct P {
    X: i32,
}

fn Main() {
    let x = _; //~ ERROR E0111 in expressions, `_` can only be used on the left-hand side of an assignment
    let t = (1, ..); //~ ERROR E0107 not yet supported: range expressions outside an index
    let p = P { X: 1, .. }; //~ ERROR E0112 base expression required after `..`
    Use((_, 1)); //~ ERROR E0111 in expressions, `_` can only be used on the left-hand side of an assignment
    let mut a = 0;
    a = _; //~ ERROR E0111 in expressions, `_` can only be used on the left-hand side of an assignment
    (a, .., ..) = (1, 2, 3); //~ ERROR E0113 `..` can only be used once per tuple pattern
    let (b, .., c, ..) = (1, 2, 3); //~ ERROR E0113 `..` can only be used once per tuple pattern
    [a, _] = [1, 2]; //~ ERROR E0107 not yet supported: destructuring assignment of an array
    (_, a) = (1, 2);
    P { X: a, .. } = P { X: 1 };
}
