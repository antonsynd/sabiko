// A range is an expression only as the whole index of `e[...]` (#10): range values
// (`Range`, `RangeFull`, `RangeInclusive`) need generic types (Phase 6), so every other
// range is E0107. rustc accepts the bindings `r`, `full`, `q` and `t` (indexing with a
// range held in a local included) and rejects the last two lines for other reasons (their
// `// rustc` comments).
fn Take(n: usize) -> usize {
    n
}

fn Main() {
    let s = "hello";
    let r = 1..3; // rustc accepts (std::ops::Range<usize>)
    //~^ ERROR E0107 not yet supported: range expressions outside an index
    let full = ..; // rustc accepts (RangeFull)
    //~^ ERROR E0107 not yet supported: range expressions outside an index
    let q = 1..=3; // rustc accepts (RangeInclusive<i32>)
    //~^ ERROR E0107 not yet supported: range expressions outside an index
    let t = &s[r]; // rustc accepts
    PrintLine(Take(0..2)); // rustc E0308: mismatched types [expected `usize`, found `Range<{integer}>`]
    //~^ ERROR E0107 not yet supported: range expressions outside an index
    PrintLine(1..3); // rustc E0277: `std::ops::Range<{integer}>` doesn't implement `std::fmt::Display`
    //~^ ERROR E0107 not yet supported: range expressions outside an index
}
