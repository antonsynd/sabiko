// `if let ... && ...` (let chains) is valid edition 2024 but not supported yet (#86).
// (Nested `if let` or a guard in a `match` say the same.)
enum Cell { Empty, Value(i32) }

fn F(c: Cell) -> i32 {
    if let Cell::Value(n) = c && n > 0 { //~ ERROR E0100 let chains are not supported yet
        return n;
    }
    0
}
