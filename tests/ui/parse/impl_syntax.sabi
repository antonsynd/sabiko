// What inherent `impl` blocks do not support yet (generics, trait impls, associated
// types, explicit `self` types and lifetimes), and a `self` parameter that
// is not first (rustc: "unexpected `self` parameter in function").
struct P { X: i32 }

impl<T> P { } // parses; the resolver rejects a block whose type does not take its parameters

impl Clone for P { } //~ ERROR E0107 not yet supported: trait implementations other than `impl Drop`

impl P {
    const C: i32 = 1;
    type T = i32; //~ ERROR E0107 not yet supported: associated types
    fn A(x: i32, self) { } //~ ERROR E0110 unexpected `self` parameter in function
    fn B(self: P) { } //~ ERROR E0107 not yet supported: explicit `self` types
    fn C(&'a self) { } //~ ERROR E0107 not yet supported: explicit lifetimes
    struct Q; //~ ERROR E0101 expected a function or a constant in this `impl` block
    fn D(&mut self) -> i32 { self.X }
}
