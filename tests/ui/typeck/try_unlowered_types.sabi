// `?` on an `Option` or a `Result` whose value or error type did not lower (here: an
// array as a generic argument) is reported rather than compiled (decision 93), in each
// function, whatever errors other functions have. Once such types lower, these programs
// are valid Rust and this test becomes a run-time one.
fn Payload(o: Option<[u8; 2]>) -> Option<u8> {
    let a = o?; //~ ERROR E0107 not yet supported: a type of this `?`
    Some(a[0])
}

fn ResultPayload(r: Result<[u8; 2], u8>) -> Result<u8, u8> {
    let a = r?; //~ ERROR E0107 not yet supported: a type of this `?`
    Ok(a[0])
}

fn Unrelated() -> i32 {
    true //~ ERROR E0300 mismatched types
}

fn Error(r: Result<u8, [u8; 2]>) -> Result<u8, [u8; 2]> {
    Ok(r?) //~ ERROR E0107 not yet supported: a type of this `?`
}

fn Main() {}
