// A `let` whose type nothing constrains is an error; deferred initialisation and diverging initialisers are fine.
fn Main() {
    let x; //~ ERROR E0313 type annotations needed
    let y: _; //~ ERROR E0313 type annotations needed
    // One report per unknown type: `w` and `v` share `z`'s problem.
    let z; //~ ERROR E0313 type annotations needed
    let w = z;
    let v: &_ = &w;
}

fn Deferred() -> i32 {
    let a;
    a = 1;
    let b;
    b = a;
    let c: _ = b;
    let d;
    d = &c;
    b + *d
}

// A diverging initialiser leaves the binding unconstrained; like rustc, it falls back to `()`.
fn Diverging() -> i32 {
    let n = return 1;
}

fn DivergingLoop() -> i32 {
    let n = loop {};
}

fn DivergingConstrained() -> i32 {
    let n = return 1;
    let m: i32 = n;
    m
}

// Indexing a value of unknown type needs its type (rustc's E0282), reported once.
fn IndexUnknown() {
    let v;
    let w: i32 = v[0]; //~ ERROR E0313 type annotations needed
}

// A value no local holds needs its type too (#78): the innermost unknown expression is
// reported, once per body, as rustc does.
fn WildcardTuple() {
    let x = 1i32;
    (_, _) = (x, []); //~ ERROR E0313 type annotations needed
}

fn WildcardLet() {
    let _ = ([], []); //~ ERROR E0313 type annotations needed
}

fn WildcardSlice() {
    let _ = &[][..]; //~ ERROR E0313 type annotations needed
}

fn EmptyArrayStatement() {
    []; //~ ERROR E0313 type annotations needed
}

fn EmptyArrayLen() -> usize {
    [].len() //~ ERROR E0313 type annotations needed
}

fn EmptyArrayConstrained() -> usize {
    let _: [i32; 0] = [];
    let a = [];
    let _ = (1u8, &a);
    let _: [i64; 0] = a;
    [0u8; 0].len()
}
