// A `&str` is indexed by ranges only (#10): an integer index, also of a slice of a string,
// is rustc's E0277 ("string indices are ranges of `usize`") and Sabiko's E0336, as in
// `typeck/index_non_indexable.sabi`.
fn Main() {
    let s = "hello";
    let i: usize = 1;
    let a = s[0]; // rustc E0277: the type `str` cannot be indexed by `{integer}` [string indices are ranges of `usize`]
    //~^ ERROR E0336 cannot index into a value of type `&str`
    let b = s[i]; // rustc E0277: the type `str` cannot be indexed by `usize` [string indices are ranges of `usize`]
    //~^ ERROR E0336 cannot index into a value of type `&str`
    let c = s[1..3][0]; // rustc E0277: the type `str` cannot be indexed by `{integer}` [string indices are ranges of `usize`]
    //~^ ERROR E0336 cannot index into a value of type `str`
    let d = &s[i..][i]; // rustc E0277: the type `str` cannot be indexed by `usize` [string indices are ranges of `usize`]
    //~^ ERROR E0336 cannot index into a value of type `str`
}
