// The item-level type rules see through tuples: a struct containing itself inside a tuple
// field is infinitely large (rustc E0072), a tuple field holding a reference needs a
// lifetime (rustc E0106; not yet supported, Phase 9), and `str` is unsized as a tuple
// element (rustc E0277).
struct S { A: (i32, S) } //~ ERROR E0206 recursive type `S` has infinite size

struct T { B: (&i32,) } //~ ERROR E0107 not yet supported: references in struct fields

fn F(x: (str, i32)) {} //~ ERROR E0208 the size for values of type `str` cannot be known at compilation time
