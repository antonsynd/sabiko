// Sabiko codes for rustc's: E0300 for E0308, E0307 for E0600, E0316 for E0080.
// An array length is a `usize`: a suffixed literal of another type, or a constant of
// another type, is E0308; `-1` as a `usize` is E0600. A length whose evaluation
// overflows or divides by zero is E0080, reported at the length.
const LEN: i32 = 2;

fn Main() {
    let a = [0; 3i32]; //~ ERROR E0300 mismatched types
    let b: [i32; 2u8] = [1, 2]; //~ ERROR E0300 mismatched types
    let c = [0; LEN]; //~ ERROR E0300 mismatched types
    let d = [0; -1]; //~ ERROR E0307 cannot apply unary operator `-` to type `usize`
    let e = [0; 2 - 3]; //~ ERROR E0316 attempt to subtract with overflow
    let f: [u8; 1 / 0] = []; //~ ERROR E0316 attempt to divide by zero
}
