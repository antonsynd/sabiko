// Sabiko codes for rustc's: E0212 for E0599, E0302 for E0063, E0304 for E0061, E0305 for E0618.
// Constructing a variant follows its shape: a tuple variant takes its fields as call
// arguments (E0061 for the wrong count), a struct variant names every field (E0063), a
// unit variant is not callable (E0618), and an unknown variant is E0599.
enum Shape { Dot, Square(i32), Rect { W: i32, H: i32 } }

fn Main() {
    let a = Shape::Square(1, 2); //~ ERROR E0304 this enum variant takes 1 argument but 2 arguments were supplied
    let b = Shape::Rect { W: 1 }; //~ ERROR E0302 missing field `H` in initializer of `Shape`
    let c = Shape::Dot(); //~ ERROR E0305 expected function, found enum variant `Shape::Dot`
    let d = Shape::Circle(3); //~ ERROR E0212 no variant or associated item named `Circle` found for enum `Shape`
}
