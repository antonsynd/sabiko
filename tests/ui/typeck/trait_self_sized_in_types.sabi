// Sabiko's E0208 for rustc's E0277. In a trait's provided method `Self` may be unsized,
// so it cannot be a struct's type argument either: the struct holds it by value
// (`holds_by_value`), in a parameter, the return type or a local.
struct W<T> {
    V: T,
}

trait Make {
    fn Make() -> Self;
    fn Wrapped(w: W<Self>) -> i32 { //~ ERROR E0208 the size for values of type `Self` cannot be known at compilation time
        1
    }
    fn Back() -> W<Self> { //~ ERROR E0208 the size for values of type `Self` cannot be known at compilation time
        W { V: Self::Make() }
    }
    fn Local() -> i32 {
        let w = W { V: Self::Make() }; //~ ERROR E0208 the size for values of type `Self` cannot be known at compilation time
        2
    }
}

fn Main() {}
