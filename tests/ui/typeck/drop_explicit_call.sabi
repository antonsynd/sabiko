// `drop` cannot be called explicitly, as a method or through the type's path (Rust's way
// to drop early is `std::mem::drop`; Sabiko programs pass the value to a by-value function).
// Checked against rustc: E0040 (the Sabiko codes are annotated).
struct D { Id: i32 }

impl Drop for D {
    fn drop(&mut self) {
        PrintLine(self.Id);
    }
}

fn Main() {
    let mut d = D { Id: 1 };
    d.drop(); //~ ERROR E0323 explicit use of destructor method
    D::drop(&mut d); //~ ERROR E0323 explicit use of destructor method
}
