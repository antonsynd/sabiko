// Primitives have no user methods: calling one is E0599, and an inherent impl for a
// primitive type is rejected (E0390).
// rustc: E0390, E0599 (checked with the pinned rustc).
impl i32 { //~ ERROR E0211 cannot define inherent `impl` for primitive types
    fn Double(self) -> i32 { self * 2 }
}

fn Main() {
    let x: i32 = 5;
    let a = x.Triple(); //~ ERROR E0319 no method named `Triple` found for type `i32`
    let b = 5.Triple(); //~ ERROR E0319 no method named `Triple` found for type `{integer}`
    let c = true.Not(); //~ ERROR E0319 no method named `Not` found for type `bool`
    let d = 1.5f64.Half(); //~ ERROR E0319 no method named `Half` found for type `f64`
}
