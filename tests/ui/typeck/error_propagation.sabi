// One mistake, one report: an operand whose type is already an error (an unresolved
// name, a failed operator) or `!` is accepted by every operator, cast and binding that
// uses it.
struct Inner {
    A: i32,
}

#[derive(Copy, Clone)]
struct Outer {
    I: Inner, //~ ERROR E0417 the trait `Copy` cannot be implemented for type `Outer`
}

fn Unresolved() {
    let a = -Missing; //~ ERROR E0202 cannot find value `Missing`
    let b = 1 << Missing; //~ ERROR E0202 cannot find value `Missing`
    let c = Missing as u8; //~ ERROR E0202 cannot find value `Missing`
    let d = 1u8 as Nope; //~ ERROR E0201 cannot find type `Nope`
    let e = &1 == Missing; //~ ERROR E0202 cannot find value `Missing`
}

fn FailedOperator() {
    let a = true + true; //~ ERROR E0306 binary operation `+` cannot be applied to type `bool`
    let b: i32 = a;
    let c = true << 1; //~ ERROR E0306 binary operation `<<` cannot be applied to type `bool`
    let d: i32 = c;
}

fn RefOperand() {
    let r: &u8 = &true; //~ ERROR E0300 mismatched types
}

fn InferredReferent() {
    let r: &_ = &5u8;
    let x: bool = *r; //~ ERROR E0300 mismatched types
}

fn AssignTarget() {
    (1 + true) = 5; //~ ERROR E0310 invalid left-hand side of assignment
    //~^ ERROR E0300 mismatched types
}

fn PrintUnknown() {
    let x;
    PrintLine(&x); //~ ERROR E0313 type annotations needed
}

fn OneBranchReturns(b: bool) -> i32 {
    if b {
        return 1;
    } else {} //~ ERROR E0300 mismatched types
}

fn OneBranchReturnsStatement(b: bool) -> i32 {
    if b {
        return 1;
    } else {
        PrintLine(0);
    };
    let after = 2;
} //~ ERROR E0300 mismatched types

const NARROW: i32 = 5u8; //~ ERROR E0300 mismatched types
const WIDER: i32 = NARROW + 1;

fn Main() {}
