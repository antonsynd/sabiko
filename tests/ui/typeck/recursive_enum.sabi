// Sabiko codes for rustc's: E0206 for E0072.
// An enum that contains itself by value has infinite size (E0072); it needs a `Box`,
// which arrives later. Also through a struct, where rustc reports the cycle at the type
// that comes first.
enum List { Nil, Cons(i32, List) } //~ ERROR E0206 recursive type `List` has infinite size

struct Node { Next: Link } //~ ERROR E0206 recursive types `Node` and `Link` have infinite size

enum Link { End, More(Node) }
