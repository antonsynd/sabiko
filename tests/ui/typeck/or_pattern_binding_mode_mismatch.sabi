// Sabiko codes for rustc's: E0219 for E0409, E0300 for E0308.
// ... and the same binding mode: `ref x` in one alternative and `x` in another is E0409.
enum Pair { Left(i32), Right(i32) }

fn F(p: Pair) -> i32 {
    match p {
        Pair::Left(ref x) | Pair::Right(x) => 1, //~ ERROR E0219 variable `x` is bound inconsistently across `|` patterns
        //~^ ERROR E0300 mismatched types
    }
}
