// Milestone A: the design-note examples compile, verify and run.
struct Point {
    X: i32,
    Y: i32,
}

fn AddOne(val: &mut i32) {
    *val = *val + 1;
}

fn MovePoint(p: &mut Point, dx: i32, dy: i32) {
    p.X = p.X + dx;
    p.Y = p.Y + dy;
}

fn Main() {
    let mut count = 5;
    AddOne(&mut count);
    PrintLine(count);
    let mut cursor = Point { X: 10, Y: 10 };
    MovePoint(&mut cursor, 5, -2);
    PrintLine(cursor.X);
    PrintLine(cursor.Y);
    Print("done");
    PrintLine('!');
    PrintLine(true);
    PrintLine(2.5);
}
