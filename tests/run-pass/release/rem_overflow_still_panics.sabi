//@ release
//@ exit-code: 101
// Remainder overflow is not a wrapping operation: `MIN % -1` panics even in release builds,
// including on narrow types computed at `int32` width.
fn Rem8(a: i8, b: i8) -> i8 { a % b }
fn Rem16(a: i16, b: i16) -> i16 { a % b }

fn Main() {
    let min8: i8 = -128;
    let min16: i16 = -32768;
    PrintLine(Rem8(min8, 3));
    PrintLine(Rem16(min16, -3));
    PrintLine(Rem8(min8 + 1, -1));
    PrintLine("about to overflow");
    PrintLine(Rem8(min8, -1));
    PrintLine("not reached");
}
