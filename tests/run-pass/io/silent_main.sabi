// A `Main` that computes but never prints exits with 0 and empty stdout.
fn Work(n: i32) -> i32 {
    let mut acc = 0;
    let mut i = 0;
    while i < n { acc += i; i += 1; }
    acc
}

fn Main() {
    let total = Work(100);
    if total < 0 { PrintLine("impossible"); }
    let flag = total == 4950;
    if !flag { PrintLine("wrong"); }
}
