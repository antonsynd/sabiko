// `Drop` can only be implemented for a struct (or enum) defined in the program: not for a
// primitive, a tuple or a reference. For the first two rustc also reports the orphan rule
// (E0117: `Drop` is not the program's trait and the type is not its type).
struct D { Id: i32 }

impl Drop for i32 { //~ rustc E0117: only traits defined in the current crate can be implemented for primitive types //~ rustc E0120: the `Drop` trait may only be implemented for local structs, enums, and unions [must be a struct, enum, or union in the current crate]
    fn drop(&mut self) {}
}

impl Drop for (D, D) { //~ rustc E0117: only traits defined in the current crate can be implemented for arbitrary types //~ rustc E0120: the `Drop` trait may only be implemented for local structs, enums, and unions
    fn drop(&mut self) {}
}

impl Drop for &D { //~ rustc E0120: the `Drop` trait may only be implemented for local structs, enums, and unions
    fn drop(&mut self) {}
}
