// E0509: a non-Copy field cannot be moved out of a value whose type implements `Drop`
// (its `drop` will still see the whole value): not into a binding, not as an argument,
// not out of a by-value `self`. rustc reports it from the borrow checker, but E0509 is not
// in the differential harness's borrow-family list, so it is staged here.
struct D { Id: i32 }

impl Drop for D {
    fn drop(&mut self) {
        PrintLine(self.Id);
    }
}

struct Owner { Id: i32, Inner: D }

impl Drop for Owner {
    fn drop(&mut self) {
        PrintLine(self.Id);
    }
}

impl Owner {
    fn IntoInner(self) -> D {
        self.Inner //~ rustc E0509: cannot move out of type `Owner`, which implements the `Drop` trait [cannot move out of here]
    }
}

fn Consume(d: D) {}

fn Main() {
    let a = Owner { Id: 1, Inner: D { Id: 2 } };
    let inner = a.Inner; //~ rustc E0509: cannot move out of type `Owner`, which implements the `Drop` trait [cannot move out of here]
    let b = Owner { Id: 3, Inner: D { Id: 4 } };
    Consume(b.Inner); //~ rustc E0509: cannot move out of type `Owner`, which implements the `Drop` trait [cannot move out of here]
}
