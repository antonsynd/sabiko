// A type has at most one `Drop` impl; rustc reports the second one.
struct D { Id: i32 }

impl Drop for D {
    fn drop(&mut self) {
        PrintLine(self.Id);
    }
}

impl Drop for D { //~ rustc E0119: conflicting implementations of trait `Drop` for type `D` [conflicting implementation for `D`]
    fn drop(&mut self) {}
}
