// A struct holding a droppable (hence neither Copy nor Clone) field cannot derive `Copy`
// or `Clone`. rustc's E0204 is in the differential harness's borrow family, but the
// `Clone` error that comes with it is not, so this is a UI test.
struct D { Id: i32 }

impl Drop for D {
    fn drop(&mut self) {
        PrintLine(self.Id);
    }
}

#[derive(Copy, Clone)]
struct W { Inner: D, N: i32 } //~ rustc E0204: the trait `Copy` cannot be implemented for this type [this field does not implement `Copy`] //~ rustc E0277: the trait bound `D: Clone` is not satisfied [the trait `Clone` is not implemented for `D`]
