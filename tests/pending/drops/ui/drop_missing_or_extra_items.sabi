// An `impl Drop` must define `drop` (lowercase: the trait's method keeps Rust's name, not
// Sabiko's PascalCase convention) and nothing else: an empty impl misses it, and `Drop` or
// any other name is not a member of the trait.
struct A { Id: i32 }
struct B { Id: i32 }
struct C { Id: i32 }

impl Drop for A {} //~ rustc E0046: not all trait items implemented, missing: `drop` [missing `drop` in implementation]

impl Drop for B { //~ rustc E0046: not all trait items implemented, missing: `drop` [missing `drop` in implementation]
    fn Drop(&mut self) {} //~ rustc E0407: method `Drop` is not a member of trait `Drop` [help: there is an associated function with a similar name: `drop`]
}

impl Drop for C {
    fn drop(&mut self) {}
    fn Extra(&self) {} //~ rustc E0407: method `Extra` is not a member of trait `Drop` [not a member of trait `Drop`]
}
