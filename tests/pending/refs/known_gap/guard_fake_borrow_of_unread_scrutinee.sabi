// KNOWN GAP (borrow checking, not specific to #11; found by the generator at seed 5001979):
// no pattern of the `match` inspects `p` (its arms are `_`), so rustc's guard takes no fake
// borrow of `p` and `r`'s live `&mut` loan is not in conflict. Sabiko reports E0408
// ("cannot borrow `p` as immutable because it is also borrowed as mutable") at the
// scrutinee. Without the guard (`match p { _ => 2 }`) both accept. Belongs in
// `differential/loans/` (as `ok_`) once a guard's fake borrow only covers places a
// pattern reads.
struct P { A: i32 }

fn Main() {
    let mut p = P { A: 1i32 };
    let r = &mut p;
    let x = match p { _ if false => 1i32, _ => 2i32 };
    r.A += x;
    PrintLine(p.A);
}
