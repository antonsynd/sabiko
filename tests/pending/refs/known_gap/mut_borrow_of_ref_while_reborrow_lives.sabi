// KNOWN GAP (borrow checking, found by the generator at seed 5001324): `d` reborrows `*m`,
// a place behind a shared reference, and rustc does not let such a loan conflict with
// borrowing (or assigning) `m` itself, so `&mut m` and the retarget are fine while `d`
// lives, and `d` keeps pointing at `x`. Sabiko reports E0408 ("cannot borrow `m` as
// mutable because it is also borrowed as immutable") at `&mut m`. Assigning `m = &y;`
// directly is accepted by both. The `&str` form (`let d = &m[1..];`) behaves the same.
// Belongs in `differential/loans/` (as `ok_`) once the conflict rule matches rustc.
fn Main() {
    let x = 1i32;
    let y = 2i32;
    let mut m: &i32 = &x;
    let d: &i32 = &*m;
    let a: &mut &i32 = &mut m;
    *a = &y;
    PrintLine(*d);
    PrintLine(*m);
    let mut s: &str = "abc";
    let t: &str = &s[1..];
    let u: &mut &str = &mut s;
    *u = "x";
    PrintLine(t);
    PrintLine(s);
}
