// A reference into a slice parameter's elements may be returned (elision ties it to the
// slice), from `&[T]` and `&mut [T]`; the caller's array stays borrowed while it is used.
fn Largest(s: &[i32]) -> &i32 {
    let mut best = 0;
    let mut i = 1;
    while i < s.len() {
        if s[i] > s[best] {
            best = i;
        }
        i += 1;
    }
    &s[best]
}

fn LastMut(s: &mut [i32]) -> &mut i32 {
    let n = s.len();
    &mut s[n - 1]
}

fn Main() {
    let mut a = [4, 9, 2];
    let m = Largest(&a);
    PrintLine(*m);
    *LastMut(&mut a) += 10;
    let last = LastMut(&mut a);
    *last += 1;
    PrintLine(a[2]);
}
