// A `usize` index above `u32::MAX`: 4294967296 is out of bounds, it must not wrap to 0
// (a bounds check on a truncated 32-bit index would read `a[0]`). The message prints the
// full index.
fn Get(a: &[i32], i: usize) -> i32 {
    a[i]
}

fn Main() {
    let a = [7, 8, 9];
    PrintLine(Get(&a, 2));
    PrintLine(Get(&a, 4294967296));
    PrintLine("not reached");
}
