// Arrays and slices are indexed by `usize` only (E0277 "the type `[i32]` cannot be indexed
// by `i32`"; the array is named as the slice it unsizes to): no other integer type
// converts implicitly. An unsuffixed literal index is a `usize`, so a negative one is an
// uncoded error, and a `bool` is E0277 too.
fn Main() {
    let a: [i32; 3] = [1, 2, 3];
    let i: i32 = 1;
    let j: u32 = 1;
    let k: u64 = 1;
    let x = a[i]; //~ rustc E0277: the type `[i32]` cannot be indexed by `i32` [slice indices are of type `usize` or ranges of `usize`]
    let y = a[j]; //~ rustc E0277: the type `[i32]` cannot be indexed by `u32`
    let z = a[k]; //~ rustc E0277: the type `[i32]` cannot be indexed by `u64`
    let w = a[-1]; //~ rustc -: negative integers cannot be used to index on a `[i32; 3]` [cannot use a negative integer for indexing on `[i32; 3]`]
    let s: &[i32] = &a;
    let v = s[true]; //~ rustc E0277: the type `[i32]` cannot be indexed by `bool`
}
