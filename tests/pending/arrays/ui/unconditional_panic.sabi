// A constant index that rustc's MIR lint can prove out of bounds is the deny-by-default
// `unconditional_panic` lint, an error without a code ("this operation will panic at
// runtime"), labelled "index out of bounds: the length is 3 but the index is 5" (the lint
// says "length", the run-time panic says "len"). It sees through `const` items, locals
// holding constants (`let i = 4;`) and `&[i32; 3]` parameters, for reads and writes; a
// slice's length is unknown, so `G` compiles and panics at run time. The lint runs only
// when the crate is code-generated: `--emit=metadata` (the compile-time differential
// harness) does not report it, the run harness does.
const N: usize = 3;

fn A() -> i32 {
    let a = [1, 2, 3];
    a[5] //~ rustc -: this operation will panic at runtime [index out of bounds: the length is 3 but the index is 5]
}

fn B() -> i32 {
    let a = [1, 2, 3];
    a[N] //~ rustc -: this operation will panic at runtime [index out of bounds: the length is 3 but the index is 3]
}

fn C() {
    let mut a = [0; 2];
    a[2] = 1; //~ rustc -: this operation will panic at runtime [index out of bounds: the length is 2 but the index is 2]
}

fn D() -> i32 {
    let a: [i32; 0] = [];
    a[0] //~ rustc -: this operation will panic at runtime [index out of bounds: the length is 0 but the index is 0]
}

fn E() -> i32 {
    let a = [1, 2, 3];
    let i = 4;
    a[i] //~ rustc -: this operation will panic at runtime [index out of bounds: the length is 3 but the index is 4]
}

fn F(r: &[i32; 3]) -> i32 {
    r[3] //~ rustc -: this operation will panic at runtime [index out of bounds: the length is 3 but the index is 3]
}

fn G(s: &[i32]) -> i32 {
    s[5]
}
