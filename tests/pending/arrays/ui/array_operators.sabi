// Arrays have no arithmetic and do not cast: `a + b` is E0369, `-a` E0600, `a as i32`
// E0605, and an element plus an array E0277. (`==` and `<` on arrays are valid Rust:
// known_gap/array_equality.sabi.)
fn Main() {
    let a: [i32; 2] = [1, 2];
    let b: [i32; 2] = [3, 4];
    let c = a + b; //~ rustc E0369: cannot add `[i32; 2]` to `[i32; 2]`
    let d = -a; //~ rustc E0600: cannot apply unary operator `-` to type `[i32; 2]` [cannot apply unary operator `-`]
    let e = a as i32; //~ rustc E0605: non-primitive cast: `[i32; 2]` as `i32`
    let f = a[0] + b; //~ rustc E0277: cannot add `[i32; 2]` to `i32`
}
