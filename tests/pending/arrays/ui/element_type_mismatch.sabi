// Every element of an array literal has the element type: a `bool` among integers, two
// differently suffixed literals, and an element assignment of another type are E0308.
fn Main() {
    let a = [1, true]; //~ rustc E0308: mismatched types [expected integer, found `bool`]
    let mut c = [0i32; 2];
    c[0] = 1.5; //~ rustc E0308: mismatched types [expected `i32`, found floating-point number]
    c[1] = 2i64; //~ rustc E0308: mismatched types [expected `i32`, found `i64`]
    let d = [1u8, 2u16]; //~ rustc E0308: mismatched types [expected `u8`, found `u16`]
}
