// An array length is a `usize`: a suffixed literal of another type, or a constant of
// another type, is E0308; `-1` as a `usize` is E0600.
const LEN: i32 = 2;

fn Main() {
    let a = [0; 3i32]; //~ rustc E0308: mismatched types [expected `usize`, found `i32`]
    let b: [i32; 2u8] = [1, 2]; //~ rustc E0308: mismatched types [expected `usize`, found `u8`]
    let c = [0; LEN]; //~ rustc E0308: mismatched types [expected `usize`, found `i32`]
    let d = [0; -1]; //~ rustc E0600: cannot apply unary operator `-` to type `usize` [cannot apply unary operator `-`]
}
