// KNOWN GAP (tuple comparison, Phase 6 operator traits): rustc runs this; Sabiko rejects
// every tuple comparison with E0107 "not yet supported: comparing tuples"
// (`tests/ui/typeck/tuple_unsupported.sabi`), as it does for structs. Belongs in
// `differential/run/tuples/` once comparison traits land; the NaN cases are the
// interesting part (rustc's lexicographic `<=` is not `!(b < a)`).
// Possibly beyond issue #6: tuple `==`, `!=` and lexicographic `<`/`>` (Rust implements
// `PartialEq`/`PartialOrd` for tuples of comparable elements, up to twelve of them).
fn Main() {
    let a = (1, 'b', true);
    let b = (1, 'b', true);
    let c = (1, 'c', false);
    PrintLine(a == b);
    PrintLine(a != c);
    PrintLine(a < c);
    PrintLine((2, 0) > (1, 99));
    PrintLine((1, (2, 3)) <= (1, (2, 3)));
    PrintLine(() == ());
    PrintLine((0.0, 1) == (-0.0, 1));
    let nan = 0.0 / 0.0;
    PrintLine((nan, 1) == (nan, 1));
    PrintLine((1.0, nan) < (2.0, nan));
    PrintLine((1.0, nan) < (1.0, nan));
    // NaN traps: `<=`/`>=` are not `!(b < a)`/`!(a < b)`, and an unordered first element
    // decides the result (false) instead of falling through to the next one.
    PrintLine((1.0, nan) <= (1.0, nan));
    PrintLine((nan, 1) >= (nan, 0));
    PrintLine((nan, 1) < (nan, 2));
    let r = &a;
    PrintLine(*r == b);
    PrintLine(r == &b);
}
