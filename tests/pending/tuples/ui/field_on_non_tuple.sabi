// `.0` on values that are not tuples (primitives, structs with named fields, references to
// them), and a named field on a tuple.
struct P { X: i32 }

fn Main() {
    let x = 5;
    let a = x.0; //~ rustc E0610: `{integer}` is a primitive type and therefore doesn't have fields
    let p = P { X: 1 };
    let b = p.0; //~ rustc E0609: no field `0` on type `P`
    let r = &p;
    let c = r.0; //~ rustc E0609: no field `0` on type `&P`
    let f = 1.5f64;
    let d = f.0; //~ rustc E0610: `f64` is a primitive type and therefore doesn't have fields
    let t = (1, 2);
    let e = t.X; //~ rustc E0609: no field `X` on type `({integer}, {integer})`
}
