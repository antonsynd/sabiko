// Element types must match the expected tuple type, element by element.
fn Takes(t: (u8, bool)) {}

fn Gives() -> (i32, char) {
    (1, "c") //~ rustc E0308: mismatched types [expected `char`, found `&str`]
}

fn Main() {
    let t: (i32, bool) = (1, 2); //~ rustc E0308: mismatched types [expected `bool`, found integer]
    Takes((1u16, true)); //~ rustc E0308: mismatched types [expected `u8`, found `u16`]
    let mut u = (1, 'a');
    u.1 = 2; //~ rustc E0308: mismatched types
    let mut w = (1, 'a');
    w = ('a', 1); //~ rustc E0308: mismatched types [expected integer, found `char`] //~ rustc E0308: mismatched types
    let (x, y): (i32, i32) = (1, false); //~ rustc E0308: mismatched types [expected `i32`, found `bool`]
    let unit: () = (1,); //~ rustc E0308: mismatched types [expected `()`, found `({integer},)`]
}
