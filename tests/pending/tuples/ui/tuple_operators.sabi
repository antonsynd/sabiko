// Tuples have no arithmetic, are not `Display` (neither is `()`), and do not cast;
// comparison needs both tuples to have the same element types.
fn Main() {
    let t = (1, 2);
    let a = t + (3, 4); //~ rustc E0369: cannot add `({integer}, {integer})` to `({integer}, {integer})`
    let b = -t; //~ rustc E0600: cannot apply unary operator `-` to type `({integer}, {integer})`
    PrintLine(t); //~ rustc E0277: `({integer}, {integer})` doesn't implement `std::fmt::Display`
    Print(()); //~ rustc E0277: `()` doesn't implement `std::fmt::Display`
    let c = t as i32; //~ rustc E0605: non-primitive cast: `({integer}, {integer})` as `i32`
    let d = (1, 2) == (1, 2, 3); //~ rustc E0308: mismatched types [expected a tuple with 2 elements, found one with 3 elements]
    let e = (1, 'a') < (1, 2); //~ rustc E0308: mismatched types
}
