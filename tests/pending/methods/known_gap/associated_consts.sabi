// KNOWN GAP (associated constants, not part of #7, which adds associated functions only):
// `const` items inside an inherent impl, reached as `Type::Name` from outside and as
// `Self::Name`/`Type::Name` from inside. A natural next step once `Type::Item` paths
// exist; belongs in `differential/run/methods/` when associated constants land.
struct Grid { W: i32 }

impl Grid {
    const Default: i32 = 8;
    const Cells: i32 = Grid::Default * Grid::Default;

    fn New() -> Grid { Grid { W: Grid::Default } }
    fn Area(&self) -> i32 { self.W * self.W }
    fn IsDefault(&self) -> bool { self.Area() == Self::Cells }
}

fn Main() {
    let g = Grid::New();
    PrintLine(Grid::Cells);
    PrintLine(g.IsDefault());
    PrintLine(Grid { W: 3 }.IsDefault());
}
