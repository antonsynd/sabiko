// `Type::Name` lookup failures: an associated function that does not exist, and an
// associated function (no `self`) called with method syntax.
struct P { X: i32 }

impl P {
    fn New() -> P { P { X: 0 } }
}

fn Main() {
    let p = P::Nope(); //~ rustc E0599: no associated function or constant named `Nope` found for struct `P` in the current scope [associated function or constant not found in `P`]
    let q = P::New();
    let r = q.New(); //~ rustc E0599: no method named `New` found for struct `P` in the current scope [this is an associated function, not a method]
}
