// A method called as an associated function takes its receiver as an ordinary first
// argument, with no auto-ref or auto-deref: it must have exactly the receiver's type.
struct P { X: i32 }
struct Q { X: i32 }

impl P {
    fn Get(&self) -> i32 { self.X }
    fn Inc(&mut self) { self.X += 1; }
    fn Consume(self) -> i32 { self.X }
}

fn Main() {
    let mut p = P { X: 1 };
    let q = Q { X: 2 };
    let a = P::Get(p); //~ rustc E0308: mismatched types [expected `&P`, found `P`]
    let b = P::Get(5); //~ rustc E0308: mismatched types [expected `&P`, found integer]
    P::Inc(&p); //~ rustc E0308: mismatched types [types differ in mutability]
    let c = P::Get(&q); //~ rustc E0308: mismatched types [expected `&P`, found `&Q`]
    let d = P::Consume(&p); //~ rustc E0308: mismatched types [expected `P`, found `&P`]
}
