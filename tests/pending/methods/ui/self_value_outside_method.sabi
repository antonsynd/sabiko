// `self` is only a value inside a method with a `self` parameter: not in an associated
// function without one, not in a free function.
struct P { X: i32 }

impl P {
    fn New() -> P {
        P { X: self.X } //~ rustc E0424: cannot find value `self` in this scope [`self` value is a keyword only available in methods with a `self` parameter]
    }
}

fn Free() -> i32 {
    self.X //~ rustc E0424: cannot find value `self` in this scope
}
