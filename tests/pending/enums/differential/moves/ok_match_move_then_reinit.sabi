// A scrutinee moved out of in a match can be assigned a new value and matched again,
// also when the move happens in a loop body and every iteration reinitialises it, or
// when the arm that moves reinitialises it itself.
struct Token { Id: i32 }

enum Slot { Empty, Full(Token) }

fn Consume(t: Token) {}
fn Take(s: Slot) {}

fn Main() {
    let mut s = Slot::Full(Token { Id: 1 });
    match s {
        Slot::Full(t) => Consume(t),
        Slot::Empty => {}
    }
    s = Slot::Full(Token { Id: 2 });
    let mut i = 0;
    while i < 3 {
        match s {
            Slot::Full(t) => Consume(t),
            Slot::Empty => {}
        }
        s = Slot::Full(Token { Id: i });
        i += 1;
    }
    match s {
        Slot::Full(t) => Consume(t),
        Slot::Empty => {}
    }
    s = Slot::Full(Token { Id: 9 });
    match s {
        Slot::Full(t) => {
            Consume(t);
            s = Slot::Empty;
        }
        Slot::Empty => {}
    }
    Take(s);
}
