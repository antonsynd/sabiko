// KNOWN GAP: rustc borrow-checks code that patterns make unreachable, Sabiko does not. Its
// match lowering adds a false edge from each candidate to the next, so an arm after an
// irrefutable one is still checked, and the `else` of an irrefutable `if let` or
// `let`-`else` is kept; each marked line is an error in rustc (E0384, E0382), and Sabiko
// accepts the program (it never reaches those blocks). Found by the generator (seed
// 2001893), which now skips no check in a `match` arm after the first or in an `else`
// (TODO in sabiko_testgen). Belongs in `differential/` as `err_` programs once MIR building
// has false edges.
enum W { Only(i32, i32) }

fn LaterArm() {
    match W::Only(1, 2) {
        W::Only(_, b) => PrintLine(b),
        W::Only(a, _) => {
            a = 3; // E0384 in rustc
            PrintLine(a);
        }
    }
}

fn MoveInLaterArm() {
    let s = W::Only(4, 5);
    match 3 {
        _ => {}
        x => {
            let t = s;
            let u = s; // E0382 in rustc
        }
    }
}

fn IfLetElse() {
    let c = 1;
    if let W::Only(x, _) = W::Only(1, 2) {
        PrintLine(x);
    } else {
        c = 2; // E0384 in rustc
    }
}

fn LetElse() {
    let d = 1;
    let W::Only(y, _) = W::Only(1, 2) else {
        d = 2; // E0384 in rustc
        return;
    };
    PrintLine(y);
}

fn Main() {
    LaterArm();
    MoveInLaterArm();
    IfLetElse();
    LetElse();
}
