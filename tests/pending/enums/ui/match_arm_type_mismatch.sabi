// The arms of a match used as a value must agree: E0308 "`match` arms have incompatible
// types" (a diverging arm takes the others' type, run/enums/diverging_arms.sabi). A guard
// must be a `bool`.
enum Light { Red, Green }

fn F(l: Light) -> i32 {
    match l {
        Light::Red => 1,
        Light::Green => true, //~ rustc E0308: `match` arms have incompatible types [expected `i32`, found `bool`]
    }
}

fn G(l: Light, n: i32) -> i32 {
    match l {
        Light::Red if n => 1, //~ rustc E0308: mismatched types [expected `bool`, found `i32`]
        _ => 2,
    }
}
