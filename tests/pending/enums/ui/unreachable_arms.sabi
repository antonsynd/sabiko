// An arm that no value reaches is a warning in rustc (`unreachable_patterns`, on by
// default), not an error: after a catch-all, a repeated variant or literal, a range
// covered by earlier arms, and an or-pattern alternative covered earlier. Guarded arms
// do not make later arms unreachable.
enum Light { Red, Yellow, Green }

fn F(l: Light) -> i32 {
    match l {
        Light::Red => 1,
        _ => 2,
        Light::Green => 3, //~ rustc warning: unreachable pattern [no value can reach this]
    }
}

fn G(l: Light) -> i32 {
    match l {
        Light::Red => 1,
        Light::Yellow => 2,
        Light::Red => 3, //~ rustc warning: unreachable pattern
        Light::Green => 4,
    }
}

fn H(n: i32) -> i32 {
    match n {
        0..=9 => 1,
        10..=19 => 2,
        5..=15 => 3, //~ rustc warning: unreachable pattern
        1 | 20 => 4, //~ rustc warning: unreachable pattern
        x if x < 0 => 5,
        -1 => 6,
        _ => 7,
    }
}
