// `i8::MIN / -1` overflows the narrow type and panics even though the quotient fits a wider integer.
fn Div(a: i8, b: i8) -> i8 { a / b }

fn Main() {
    let min: i8 = -128;
    PrintLine(Div(min, 1));
    PrintLine(Div(min, -2));
    PrintLine(Div(127, -1));
    PrintLine("about to overflow");
    PrintLine(Div(min, -1));
    PrintLine("not reached");
}
