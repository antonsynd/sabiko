// `i64::MIN % -1` overflows and panics in debug builds.
fn Rem(a: i64, b: i64) -> i64 { a % b }

fn Main() {
    let min: i64 = -9223372036854775808;
    PrintLine(Rem(min, 3));
    PrintLine(Rem(min + 1, -1));
    PrintLine("about to overflow");
    PrintLine(Rem(min, -1));
    PrintLine("not reached");
}
