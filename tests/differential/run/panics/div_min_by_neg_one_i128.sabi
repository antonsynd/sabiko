// `i128::MIN / -1` overflows and panics.
fn Div(a: i128, b: i128) -> i128 { a / b }

fn Main() {
    let min: i128 = -170141183460469231731687303715884105728;
    PrintLine(Div(min, -2));
    PrintLine(Div(min + 1, -1));
    PrintLine("about to overflow");
    PrintLine(Div(min, -1));
    PrintLine("not reached");
}
