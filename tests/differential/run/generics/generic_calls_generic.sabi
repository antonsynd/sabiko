// Generic functions calling each other at their own type parameters, recursion at a
// fixed type, and the same function instantiated at several types.
fn Id<T>(x: T) -> T {
    x
}

fn Twice<T>(x: T, f: bool) -> (T, bool) {
    (Id(x), !f)
}

fn Nest<A, B>(a: A, b: B) -> ((A,), (B,)) {
    ((Id(a),), (Id(b),))
}

fn Countdown<T>(x: T, n: u32) -> T {
    if n == 0 {
        x
    } else {
        Countdown(x, n - 1)
    }
}

fn Main() {
    let t = Twice(3, false);
    PrintLine(t.0);
    PrintLine(t.1);
    let u = Twice("s", true);
    PrintLine(u.0);
    let n = Nest(1.5f32, 'q');
    PrintLine((n.0).0);
    PrintLine((n.1).0);
    PrintLine(Countdown(99, 5));
    PrintLine(Countdown((1, "deep"), 3).1);
}
