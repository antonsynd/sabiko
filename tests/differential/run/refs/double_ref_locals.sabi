// `&&i32`, `&&&i32` and deeper locals: reading through every level with `*`, copying a
// shared reference to a reference, `&&x` in one expression, and references to references
// of other primitive types. (`&&&x` in a `let` is `known_gap/nested_borrow_extension.sabi`.)
fn Main() {
    let x = 5;
    let r = &x;
    let rr = &r;
    PrintLine(**rr);
    let rrr = &rr;
    PrintLine(***rrr);
    let rrrr = &rrr;
    PrintLine(****rrrr + 1);
    let copy = rr;
    PrintLine(**copy + **rr);
    let inner: &i32 = *rr;
    PrintLine(*inner);
    let direct = &&x;
    PrintLine(**direct * 2);
    let deeper = &rrrr;
    PrintLine(*****deeper - 5);
    let b = true;
    let rb = &&b;
    PrintLine(**rb);
    let c = 'z';
    let rc = &&c;
    PrintLine(**rc);
    let f = 2.5;
    let fr = &f;
    let rf = &&fr;
    PrintLine(***rf * 2.0);
    let big: i128 = 170141183460469231731687303715884105727;
    let rbig = &&big;
    PrintLine(**rbig);
}
