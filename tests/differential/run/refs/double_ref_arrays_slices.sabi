// `&&[i32; 3]` and `&&[i32]`: `.len()` and indexing auto-dereference, a `&&[i32]`
// parameter, and writes through `&mut &mut [i32; 3]` and `&mut &mut [i32]`.
fn Sum(rs: &&[i32]) -> i32 {
    let mut i = 0;
    let mut total = 0;
    while i < rs.len() {
        total += rs[i];
        i += 1;
    }
    total
}

fn Last(ra: &&[i32; 3]) -> i32 { ra[ra.len() - 1] }

fn Main() {
    let a = [1, 2, 3];
    let r = &a;
    let rr = &r;
    PrintLine(rr.len());
    PrintLine(rr[0] + rr[2]);
    PrintLine((**rr)[1]);
    PrintLine(Last(rr));
    let s: &[i32] = &a;
    let ss = &s;
    PrintLine(ss.len());
    PrintLine(ss[1]);
    PrintLine(Sum(ss));
    PrintLine(Sum(&s));
    let mut b = [10, 20, 30];
    {
        let mut m = &mut b;
        let mm = &mut m;
        mm[0] = 11;
        mm[2] += mm[1];
        PrintLine(mm.len());
    }
    PrintLine(b[0] + b[2]);
    {
        let mut ms: &mut [i32] = &mut b;
        let mms = &mut ms;
        mms[1] = 0;
        let rms = &ms;
        PrintLine(rms[1] + rms.len() as i32);
    }
    let bs: &[i32] = &b;
    PrintLine(Sum(&bs));
}
