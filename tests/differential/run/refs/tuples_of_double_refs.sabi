// References to references as tuple elements: `(&r, 1)`, `(&&x, &y)`, read with `**t.0`
// and `*t.1`; a tuple of them passed to a function, swapped, nested and reassigned.
fn SumPair(t: (&&i32, &i32)) -> i32 { **t.0 + *t.1 }

fn Main() {
    let x = 1;
    let y = 2;
    let r = &x;
    let s = &y;
    let a = (&r, 1);
    PrintLine(**a.0 + a.1);
    let inner: &i32 = *a.0;
    PrintLine(*inner);
    let b = (&&x, &y);
    PrintLine(**b.0);
    PrintLine(*b.1);
    PrintLine(SumPair(b));
    PrintLine(SumPair((&s, &x)));
    let mut c = (&r, &s);
    c = (c.1, c.0);
    PrintLine(**c.0);
    PrintLine(**c.1);
    let nested = ((&r, 3), (&s, &&x));
    PrintLine(**nested.0.0 + nested.0.1 + **nested.1.0 + **nested.1.1);
    let mut m = (&r, 0);
    m.0 = &s;
    m.1 = **m.0;
    PrintLine(m.1);
}
