// A guard on an arm whose pattern binds a `&mut` scrutinee reference itself (`match &mut n
// { x if *x > 0 => .. }`, `match r { c if .. }` for `r: &mut Cell`). Inside the guard the
// binding denotes a shared reborrow of what it points to, not a `&&mut T` (which has no
// CIL type yet); after the guard it is the `&mut` itself. Found by the generator.
enum Cell { Empty, Value(i32) }

fn Reset(r: &mut Cell) {
    match r {
        c if IsValue(c) => *c = Cell::Empty,
        _ => {}
    }
}

fn IsValue(c: &Cell) -> bool {
    match c {
        Cell::Value(_) => true,
        Cell::Empty => false,
    }
}

fn Main() {
    let mut n = 3;
    match &mut n {
        x if *x > 0 => *x += 10,
        _ => {}
    }
    PrintLine(n);
    let mut c = Cell::Value(1);
    Reset(&mut c);
    PrintLine(IsValue(&c));
}
