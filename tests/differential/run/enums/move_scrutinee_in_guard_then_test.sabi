// A guard that moves the scrutinee out and fails, followed by arms that test it again.
// rustc tests the discriminant once, before any guard, so the later arms do not read the
// moved value; Sabiko's later candidates reuse the discriminant the first one read
// (decision 72, #47), and `RunPair` reuses a compared value the same way.
struct D { Id: i32 }

impl Drop for D {
    fn drop(&mut self) {
        PrintLine(self.Id);
    }
}

enum Slot { Empty, Full(D) }

fn Consume(s: Slot) -> bool {
    false
}

fn Run(s: Slot) -> i32 {
    match s {
        Slot::Full(_) if Consume(s) => 1,
        Slot::Empty => 0,
        Slot::Full(_) => 2,
    }
}

fn ConsumePair(t: (D, i32)) -> bool {
    false
}

fn RunPair(t: (D, i32)) -> i32 {
    match t {
        (_, 1) if ConsumePair(t) => 1,
        (_, 1) => 2,
        (_, 2) => 3,
        _ => 4,
    }
}

fn Main() {
    PrintLine(Run(Slot::Full(D { Id: 7 })));
    PrintLine(RunPair((D { Id: 5 }, 1)));
}
