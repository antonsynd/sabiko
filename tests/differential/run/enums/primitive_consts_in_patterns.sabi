// Associated constants of primitive types (#48) as range bounds and constant patterns:
// `i8::MIN..=-1 | 0 | 1..=i8::MAX` is exhaustive.
fn Sign(n: i8) -> i32 {
    match n {
        i8::MIN..=-1 => -1,
        0 => 0,
        1..=i8::MAX => 1,
    }
}

fn Wide(n: i32) -> i32 {
    match n {
        i32::MIN => 0,
        i32::MAX => 2,
        _ => 1,
    }
}

fn Main() {
    PrintLine(Sign(-128));
    PrintLine(Sign(0));
    PrintLine(Sign(127));
    PrintLine(Wide(-2147483648));
    PrintLine(Wide(2147483647));
    PrintLine(Wide(5));
}
