// Issue #133: moves out of variants, reassignments and writes through references to an
// enum in any order, also in loops; every drop reads the variant the enum holds then.
struct D {
    Id: isize,
}

impl Drop for D {
    fn drop(&mut self) {
        Print("drop ");
        PrintLine(self.Id);
    }
}

enum E {
    A(D, D),
    B(D),
    C,
}

fn Cond(n: isize) -> bool {
    n > 0
}

fn Make(n: isize, id: isize) -> E {
    if n == 0 {
        E::A(D { Id: id }, D { Id: id + 1 })
    } else if n == 1 {
        E::B(D { Id: id })
    } else {
        E::C
    }
}

fn Set(e: &mut E, n: isize, id: isize) {
    *e = Make(n, id);
}

// Move a field out, then reinitialise the whole enum, then write through a reference
// with the same variant and others.
fn T1(n: isize) {
    PrintLine("-- t1");
    let mut x = Make(n, 10);
    if let E::A(a, _) = x {
        Print("moved ");
        PrintLine(a.Id);
    }
    x = Make(0, 20);
    Set(&mut x, 0, 30);
    PrintLine("end t1");
}

// Move a field out in one arm, reassign in some paths only.
fn T2(n: isize, m: isize) {
    PrintLine("-- t2");
    let mut x = Make(n, 100);
    match x {
        E::A(a, ref b) => {
            Print("a ");
            PrintLine(a.Id);
            PrintLine(b.Id);
        }
        E::B(ref b) => {
            PrintLine(b.Id);
        }
        E::C => {}
    }
    if Cond(m) {
        x = Make(m - 1, 200);
        Set(&mut x, 1, 300);
    }
    PrintLine("end t2");
}

// The variant changes through a reference to one whose field occupies the same storage.
fn T3(n: isize) {
    PrintLine("-- t3");
    let mut x;
    if Cond(n) {
        x = E::B(D { Id: 400 });
        Set(&mut x, 0, 410);
        Set(&mut x, 1, 420);
        Set(&mut x, 2, 430);
        Set(&mut x, 1, 440);
    }
    PrintLine("end t3");
}

// Loop: conditionally initialised, written through a reference, old value dropped.
fn T4() {
    PrintLine("-- t4");
    let mut i = 0;
    let mut x = Make(2, 0);
    while i < 6 {
        i = i + 1;
        if i == 2 {
            continue;
        }
        if let E::A(a, _) = x {
            Print("loop moved ");
            PrintLine(a.Id);
            x = Make(i % 3, 1000 + i * 10);
            continue;
        }
        if i == 5 {
            break;
        }
        Set(&mut x, i % 3, 2000 + i * 10);
    }
    PrintLine("end t4");
}

fn T5(n: isize) {
    PrintLine("-- t5");
    let mut i = 0;
    while i < 3 {
        let mut y;
        if Cond(n - i) {
            y = Make(i, 3000 + i * 10);
            Set(&mut y, (i + 1) % 3, 3100 + i * 10);
            if let E::B(b) = y {
                Print("t5 moved ");
                PrintLine(b.Id);
            }
        }
        i = i + 1;
    }
    PrintLine("end t5");
}

fn Main() {
    T1(0);
    T1(1);
    T1(2);
    T2(0, 0);
    T2(0, 1);
    T2(0, 2);
    T2(1, 3);
    T2(2, 1);
    T3(1);
    T3(0);
    T4();
    T5(1);
    T5(3);
}
