// `s[i] = [..]` evaluates the elements, then the place, and only then builds the array in
// it (rustc's `as_rvalue`). When the index check panics, the elements are separate
// temporaries and drop in reverse order (`drop 3`, `drop 2`, `drop 1`), not as an array in
// element order; the moved local `b` went into one of them, so it drops there, before the
// locals still in scope (`c`, then the slot `v`). Nightly seed 960 found this.
struct D { Id: i32 }

impl Drop for D {
    fn drop(&mut self) {
        Print("drop ");
        PrintLine(self.Id);
    }
}

fn Make(id: i32) -> D {
    Print("make ");
    PrintLine(id);
    D { Id: id }
}

fn Index(n: usize) -> usize {
    PrintLine("index");
    n
}

fn Main() {
    let b = Make(2);
    let c = Make(4);
    let mut v = [[Make(10), Make(11), Make(12)]];
    v[Index(0)] = [Make(5), Make(6), Make(7)];
    PrintLine("replaced");
    v[Index(1)] = [Make(1), b, Make(3)];
    PrintLine("unreachable");
}
