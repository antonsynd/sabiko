// Loop-carried drops: a local of the loop body is dropped at the end of every iteration; a
// variable declared before the loop and assigned in it drops its previous value at each
// assignment and its last one at the end of its own scope; a value moved out in every
// iteration and reinitialised before the next is dropped exactly once per value.
struct D { Id: i32 }

impl Drop for D {
    fn drop(&mut self) {
        Print("drop ");
        PrintLine(self.Id);
    }
}

fn Make(id: i32) -> D {
    Print("make ");
    PrintLine(id);
    D { Id: id }
}

fn Consume(d: D) {
    Print("consume ");
    PrintLine(d.Id);
}

fn Main() {
    let mut i = 0;
    while i < 3 {
        let body = Make(i);
        i += 1;
    }
    PrintLine("--");
    let mut cur = Make(10);
    let mut j = 0;
    while j < 3 {
        cur = Make(11 + j);
        j += 1;
    }
    PrintLine(cur.Id);
    PrintLine("--");
    let mut held = Make(20);
    let mut k = 0;
    loop {
        Consume(held);
        k += 1;
        held = Make(20 + k);
        if k == 2 {
            break;
        }
    }
    PrintLine("--");
    let mut m = 0;
    let mut slot = Make(30);
    while m < 4 {
        if m % 2 == 0 {
            Consume(slot);
            slot = Make(31 + m);
        }
        m += 1;
    }
    PrintLine("end of Main");
}
