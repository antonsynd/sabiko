// An index whose type a later statement decides (#183): `slot.unwrap()` is open until
// `slot = Some(k)` makes it an `{integer}`, then a `usize`; the element's uses wait.
fn Main() {
    let a = [10, 20, 30];
    let mut slot = None;
    let mut k = 0;
    let mut sum = 0;
    while k < 3 {
        if k > 0 {
            let y = a[slot.unwrap()];
            sum += y;
            PrintLine(y);
        }
        slot = Some(k);
        k += 1;
    }
    PrintLine(sum);
}
