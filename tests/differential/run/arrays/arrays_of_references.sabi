// KNOWN GAP (to decide in #9): arrays whose elements are references or `&str`. A `[&i32;
// 2]` or `[&str; 2]` would be an inline array of managed pointers or of
// `ReadOnlySpan<char>`, which the CLR does not allow (a byref-like element type), the
// same problem as references in struct fields (Phase 9). Either they get a ref-struct
// representation like reference tuples (decision 52), or they are E0500.
fn Main() {
    let x = 1;
    let y = 2;
    let refs = [&x, &y];
    PrintLine(*refs[0] + *refs[1]);
    let names = ["ada", "grace"];
    PrintLine(names[1]);
    PrintLine(names.len());
    let mut p = 5;
    let mut q = 6;
    let muts = [&mut p, &mut q];
    *muts[1] += 10;
    PrintLine(q);
}
