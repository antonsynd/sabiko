// In `a[r][i] = v` the right operand is evaluated first, then the range bounds, then the
// range check, which fails here ("range end index 9 out of range for slice of length 5",
// 20:6) before the element index `Idx(0)` is evaluated.
fn Idx(i: usize) -> usize {
    Print("index ");
    PrintLine(i);
    i
}

fn Val(v: i32) -> i32 {
    Print("value ");
    PrintLine(v);
    v
}

fn Main() {
    let mut a = [0; 5];
    a[Idx(1)..Idx(3)][Idx(0)] = Val(7);
    PrintLine(a[1]);
    a[Idx(1)..Idx(9)][Idx(0)] = Val(8);
    PrintLine("not reached");
}
