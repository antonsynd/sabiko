// `a..=b` with `a > b + 1`: the order message shows the exclusive end `b + 1`, "slice
// index starts at 3 but ends at 2" (4:6); `3..=2` is empty.
fn Len(s: &[i32], a: usize, b: usize) -> usize {
    s[a..=b].len()
}

fn Main() {
    let a = [1, 2, 3, 4, 5];
    PrintLine(Len(&a, 1, 3));
    PrintLine(Len(&a, 3, 2));
    PrintLine(Len(&a, 3, 1));
    PrintLine("not reached");
}
