// Unsizing coercions at the tail of a block or `if` that is an element of a coerced tuple
// or array, or a call argument, give the block the coerced type (#94); and an array literal
// under a `&[T]` expectation has `T` elements, each a coercion site (`&[&[1, 2], &[3]]` as
// `&[&[i32]]`).
fn Sum(s: &[i32]) -> i32 {
    let mut total = 0;
    let mut i = 0;
    while i < s.len() {
        total += s[i];
        i += 1;
    }
    total
}

fn Rows(rows: &[&[i32]]) -> i32 {
    let mut total = 0;
    let mut i = 0;
    while i < rows.len() {
        total += Sum(rows[i]) * (i as i32 + 1);
        i += 1;
    }
    total
}

fn Main() {
    let a = [1, 2];
    let b = [3, 4, 5];
    let c = true;
    let u: (&[i32], i32) = ({ &a }, 1);
    PrintLine(Sum(u.0) + u.1);
    let v: (&[i32], &[i32]) = (if c { &a } else { &b }, if c { &b } else { &a });
    PrintLine(v.0.len() * 10 + v.1.len());
    let w: [&[i32]; 2] = [{ &b }, { { &a } }];
    PrintLine(Sum(w[0]) - Sum(w[1]));
    PrintLine(Sum({ &b }) + Sum(if c { &a } else { &b }));
    let n: ((&[i32], i32), i32) = (({ &b }, 1), 2);
    PrintLine((n.0).0.len());
    let rows: &[&[i32]] = &[&[1, 2], &[3], &[]];
    PrintLine(rows.len());
    PrintLine(Rows(rows));
    PrintLine(Rows(&[&a, &b, &[10]]));
    let nested: &[&[&[i32]]] = &[&[&[1], &[2, 3]], &[]];
    PrintLine(nested[0][1][1] + nested.len() as i32);
}
