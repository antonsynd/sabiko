// `i128`/`u128` constants: the extremes, values computed by constant evaluation (including
// casts to and from other types), and their formatting.
const MAX: i128 = 170141183460469231731687303715884105727;
const MIN: i128 = -MAX - 1;
const LITERAL_MIN: i128 = -170141183460469231731687303715884105728;
const UMAX: u128 = !0;
const HIGH: u128 = 1 << 127;
const SPLIT: i128 = (1 << 64) + 1;
const MIXED: u128 = (MAX as u128) * 2 + 1;
const NARROW: i64 = MIN as i64;
const LOW_BYTE: u8 = UMAX as u8;
const FLOATED: f64 = MAX as f64;
const SINGLE: f32 = UMAX as f32;
const FROM_FLOAT: i128 = 1e30 as i128;
const SATURATED: u128 = -5.0 as u128;
const WIDENED: i128 = -9223372036854775808i64 as i128;
const QUOTIENT: i128 = MIN / 3;
const REMAINDER: u128 = UMAX % 1000000007;
const SHIFTED: i128 = MIN >> 64;

fn Main() {
    PrintLine(MAX); PrintLine(MIN); PrintLine(LITERAL_MIN); PrintLine(UMAX); PrintLine(HIGH);
    PrintLine(SPLIT); PrintLine(MIXED); PrintLine(NARROW); PrintLine(LOW_BYTE); PrintLine(FLOATED);
    PrintLine(SINGLE); PrintLine(FROM_FLOAT); PrintLine(SATURATED); PrintLine(WIDENED);
    PrintLine(QUOTIENT); PrintLine(REMAINDER); PrintLine(SHIFTED);
    PrintLine(MAX - SPLIT); PrintLine(MIN + 1); PrintLine(MIN == LITERAL_MIN);
    PrintLine(0i128); PrintLine(-1i128); PrintLine(0u128); PrintLine(1u128);
    PrintLine(-170141183460469231731687303715884105728i128);
    PrintLine(-(170141183460469231731687303715884105728i128));
    let x: i128 = MIN;
    PrintLine(x / -2);
    Print(MAX); Print(' '); Print(UMAX); Print(' '); Print(-1i128); PrintLine("");
}
