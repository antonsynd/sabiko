// Shifts of every width by amounts of other integer types, all below the bit width.
fn Shl8(x: u8, n: u32) { PrintLine(x << n); }
fn Shr8(x: i8, n: i64) { PrintLine(x >> n); }
fn Shl16(x: i16, n: u8) { PrintLine(x << n); }
fn Shr16(x: u16, n: i16) { PrintLine(x >> n); }
fn Shl32(x: u32, n: i8) { PrintLine(x << n); }
fn Shr32(x: i32, n: usize) { PrintLine(x >> n); }
fn Shl64(x: i64, n: u16) { PrintLine(x << n); }
fn Shr64(x: u64, n: isize) { PrintLine(x >> n); }
fn ShrSize(x: isize, n: u64) { PrintLine(x >> n); }
fn ShlUSize(x: usize, n: i32) { PrintLine(x << n); }

fn Main() {
    Shl8(1, 7); Shl8(0xFF, 4); Shl8(3, 0);
    Shr8(-128, 7); Shr8(-1, 3); Shr8(64, 6);
    Shl16(1, 15); Shl16(-1, 8); Shl16(0x7FFF, 1);
    Shr16(0x8000, 15); Shr16(0xFFFF, 8); Shr16(1, 0);
    Shl32(1, 31); Shl32(0xFFFFFFFF, 16); Shl32(12345, 20);
    Shr32(-2147483648, 31); Shr32(-1, 20); Shr32(2147483647, 1);
    Shl64(1, 63); Shl64(-1, 32); Shl64(0x7FFFFFFFFFFFFFFF, 1);
    Shr64(0x8000000000000000, 63); Shr64(0xFFFFFFFFFFFFFFFF, 60); Shr64(1024, 10);
    ShrSize(-9223372036854775808, 63); ShrSize(-256, 4);
    ShlUSize(1, 63); ShlUSize(0xFF, 56);
    let x: i32 = -1;
    PrintLine((x as u32) >> 1);
    PrintLine(((x as u8) << 1) as i8);
}
