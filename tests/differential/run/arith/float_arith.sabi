// Float arithmetic in `f32` and `f64`: remainder, negative zero, infinities, rounding.
fn Ops64(a: f64, b: f64) {
    Print(a + b); Print(' '); Print(a - b); Print(' '); Print(a * b); Print(' ');
    Print(a / b); Print(' '); PrintLine(a % b);
}

fn Ops32(a: f32, b: f32) {
    Print(a + b); Print(' '); Print(a - b); Print(' '); Print(a * b); Print(' ');
    Print(a / b); Print(' '); PrintLine(a % b);
}

fn Main() {
    Ops64(7.5, 2.0);
    Ops64(-7.5, 2.0);
    Ops64(7.5, -2.0);
    Ops64(0.1, 0.2);
    Ops64(1.0, 3.0);
    Ops64(1.0, 0.0);
    Ops64(-1.0, 0.0);
    Ops64(0.0, 0.0);
    Ops64(1e308, 10.0);
    Ops64(5e-324, 2.0);
    Ops32(7.5, 2.0);
    Ops32(0.1, 0.2);
    Ops32(1.0, 3.0);
    Ops32(16777216.0, 1.0);
    Ops32(3e38, 10.0);
    Ops32(1.0, 0.0);
    let zero: f64 = 0.0;
    PrintLine(-zero);
    PrintLine(zero * -1.0);
    PrintLine(-zero + zero);
    PrintLine(1.0 / (-zero));
}
