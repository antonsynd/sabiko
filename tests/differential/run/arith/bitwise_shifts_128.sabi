// `& | ^ !` and shifts on `i128`/`u128`, with amounts of narrow, wide and 128-bit types.
fn ShlI(x: i128, n: u32) -> i128 { x << n }
fn ShrI(x: i128, n: i8) -> i128 { x >> n }
fn ShlU(x: u128, n: i128) -> u128 { x << n }
fn ShrU(x: u128, n: u128) -> u128 { x >> n }
fn ShlNarrow(x: u8, n: i128) -> u8 { x << n }
fn ShrWide(x: i64, n: u128) -> i64 { x >> n }
fn ShlSize(x: usize, n: i128) -> usize { x << n }

fn Main() {
    let a: i128 = -0x0123456789ABCDEF0123456789ABCDEF;
    let b: i128 = 0x7F00FF00FF00FF00FF00FF00FF00FF00;
    PrintLine(a & b); PrintLine(a | b); PrintLine(a ^ b); PrintLine(!a); PrintLine(!b);
    let c: u128 = 0xFFFF0000FFFF0000FFFF0000FFFF0000;
    let d: u128 = 0x0123456789ABCDEF0123456789ABCDEF;
    PrintLine(c & d); PrintLine(c | d); PrintLine(c ^ d); PrintLine(!c); PrintLine(!0u128);
    PrintLine(ShlI(1, 127)); PrintLine(ShlI(-1, 64)); PrintLine(ShlI(3, 0)); PrintLine(ShlI(b, 4));
    PrintLine(ShrI(-170141183460469231731687303715884105728, 127)); PrintLine(ShrI(a, 63));
    PrintLine(ShrI(b, 100)); PrintLine(ShrI(-1, 1));
    PrintLine(ShlU(1, 127)); PrintLine(ShlU(c, 8)); PrintLine(ShlU(d, 64));
    PrintLine(ShrU(340282366920938463463374607431768211455, 127)); PrintLine(ShrU(c, 64));
    PrintLine(ShrU(d, 3));
    PrintLine(ShlNarrow(0xFF, 4)); PrintLine(ShlNarrow(1, 7));
    PrintLine(ShrWide(-9223372036854775808, 63)); PrintLine(ShrWide(1024, 10));
    PrintLine(ShlSize(1, 63)); PrintLine(ShlSize(0xFF, 56));
    let mut e: u128 = 1;
    e <<= 100u8; PrintLine(e);
    e >>= 99i64; PrintLine(e);
    e |= 0x80000000000000000000000000000000; PrintLine(e);
    e &= !1; PrintLine(e);
    e ^= 3; PrintLine(e);
    let x: i128 = -1;
    PrintLine((x as u128) >> 1);
    PrintLine(((x as u8) << 1) as i128);
}
