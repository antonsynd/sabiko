// A small tokenizer: walks a string by index, groups letters and digits into words with
// nested `while` loops, and classifies each word with a string `match` (keywords),
// comparisons (`<=` on one-character slices) and `.len()`.
fn IsDigit(c: &str) -> bool {
    "0" <= c && c <= "9"
}

fn IsLetter(c: &str) -> bool {
    ("a" <= c && c <= "z") || ("A" <= c && c <= "Z") || c == "_"
}

fn Classify(word: &str) {
    match word {
        "fn" | "let" | "mut" | "while" | "if" | "else" => Print("keyword "),
        "true" | "false" => Print("bool "),
        w if IsDigit(&w[..1]) => Print("number "),
        w if w.len() == 1 => Print("short "),
        _ => Print("ident "),
    }
    PrintLine(word);
}

fn Main() {
    let src = "let mut x_1 = 42 + y; while true { x_1 = x_1 - 1 }";
    let mut i = 0;
    let mut words = 0;
    let mut symbols = 0;
    while i < src.len() {
        let c = &src[i..i + 1];
        if IsLetter(c) || IsDigit(c) {
            let start = i;
            while i < src.len() && (IsLetter(&src[i..=i]) || IsDigit(&src[i..=i])) {
                i += 1;
            }
            Classify(&src[start..i]);
            words += 1;
        } else {
            if c != " " {
                Print("symbol ");
                PrintLine(c);
                symbols += 1;
            }
            i += 1;
        }
    }
    PrintLine(words);
    PrintLine(symbols);
}
