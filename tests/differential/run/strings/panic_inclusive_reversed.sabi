// `a..=b` with `a > b + 1`: the order message shows the exclusive end `b + 1`, "byte range
// starts at 3 but ends at 2"; `3..=2` is an empty slice. At 4:7.
fn Cut(s: &str, a: usize, b: usize) -> &str {
    &s[a..=b]
}

fn Main() {
    PrintLine(Cut("hello", 1, 3));
    Print("[");
    Print(Cut("hello", 3, 2));
    PrintLine("]");
    PrintLine(Cut("hello", 3, 1));
    PrintLine("not reached");
}
