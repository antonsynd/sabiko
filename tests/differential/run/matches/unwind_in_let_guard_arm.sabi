// A panic in the arm of an `if let` guard drops the arm's locals, then what the guard holds
// (last first), then the pattern's bindings, the scrutinee and the function's locals (#98).
struct D { V: i32 }

impl Drop for D {
    fn drop(&mut self) {
        PrintLine(self.V);
    }
}

enum Maybe { Has(D), Empty }

fn Main() {
    let _g = D { V: 0 };
    match Maybe::Has(D { V: 1 }) {
        Maybe::Has(p) if let Maybe::Has(a) = Maybe::Has(D { V: 2 }) && let t = (D { V: 3 }) => {
            let _local = D { V: 4 };
            if p.V + a.V + t.V == 6 {
                Panic("boom");
            }
        }
        _ => PrintLine("other"),
    }
}
