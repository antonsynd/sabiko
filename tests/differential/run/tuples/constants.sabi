// Tuple constants (#50): built from literals, other constants and their tuple fields, used
// as values (copied, destructured, passed, borrowed with lifetime extension, indexed into
// an array length) and as patterns, where a constant matches like the tuple pattern of its
// elements and counts as one for exhaustiveness.
const P: (i32, i32) = (1, 2);
const Q: (i32, (bool, char), &str) = (P.1 * 10, (true, 'x'), "hi");
const R: i32 = Q.1 .1 as i32 + P.0;
const U: ((), u8) = ((), 255);
const ONE: (i64,) = (7,);
const N: (usize, i32) = (2, 0);
const T: (bool, (char, &str)) = (true, ('x', "hi"));
const E: (bool,) = (true,);
const A: i32 = 5;

fn Show(p: (i32, i32)) {
    PrintLine(p.0 + p.1);
}

fn F(p: (i32, i32)) -> i32 {
    match p {
        P => 1,
        (1, _) => 2,
        _ => 0,
    }
}

fn G(t: (bool, (char, &str))) -> i32 {
    match t {
        T => 10,
        (true, ('x', _)) => 11,
        _ => 12,
    }
}

fn H(e: (bool,)) -> i32 {
    match e {
        E => 20,
        (false,) => 21,
    }
}

fn Main() {
    PrintLine(P.0);
    PrintLine(P.1);
    let (a, b) = P;
    PrintLine(a * b);
    Show(P);
    PrintLine(Q.0);
    PrintLine(Q.1 .0);
    PrintLine(Q.1 .1);
    PrintLine(Q.2);
    PrintLine(R);
    PrintLine(U.1);
    PrintLine(ONE.0);
    let arr = [4; N.0];
    PrintLine(arr.len());
    let mut m = P;
    m.0 += 5;
    PrintLine(m.0);
    PrintLine(P.0);
    let r = &P;
    let s = &A;
    PrintLine(r.1 + *s);
    PrintLine(F((1, 2)));
    PrintLine(F((1, 3)));
    PrintLine(F((2, 2)));
    PrintLine(G((true, ('x', "hi"))));
    PrintLine(G((true, ('x', "ho"))));
    PrintLine(G((false, ('x', "hi"))));
    PrintLine(H((true,)));
    PrintLine(H((false,)));
}
