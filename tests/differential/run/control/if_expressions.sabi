// `if`/`else if`/`else` as statements and as expressions, nested and in call arguments.
fn Grade(score: i32) -> char {
    if score >= 90 { 'A' } else if score >= 80 { 'B' } else if score >= 70 { 'C' } else { 'F' }
}

fn Abs(x: i64) -> i64 { if x < 0 { -x } else { x } }

fn Max3(a: u8, b: u8, c: u8) -> u8 {
    let ab = if a > b { a } else { b };
    if ab > c { ab } else { c }
}

fn Main() {
    PrintLine(Grade(95)); PrintLine(Grade(85)); PrintLine(Grade(75)); PrintLine(Grade(5));
    PrintLine(Abs(-9223372036854775807)); PrintLine(Abs(42)); PrintLine(Abs(0));
    PrintLine(Max3(3, 200, 7)); PrintLine(Max3(255, 0, 1)); PrintLine(Max3(1, 1, 1));
    let mut i = 0;
    while i < 6 {
        Print(if i % 3 == 0 { "fizz" } else if i % 2 == 0 { "even" } else { "odd" });
        Print(' ');
        i += 1;
    }
    PrintLine("");
    let x = 10;
    let y = if x > 5 { if x > 8 { 3.5 } else { 2.5 } } else { 1.5 };
    PrintLine(y);
    let flag = if x == 10 { true } else { false };
    if flag { PrintLine("ten"); }
    if !flag { PrintLine("not ten"); } else { PrintLine("still ten"); }
    PrintLine(if flag { 1u64 << 40 } else { 0 });
}
