// An error type `?` leaves open takes the one type the conversions allow, before literals
// default: `Err(5)?` in a function returning `Result<_, u8>` is a `u8` error.
fn ToU8() -> Result<i32, u8> {
    let x: i32 = Err(5)?;
    Ok(x)
}

fn ToI8() -> Result<i32, i8> {
    let x: i32 = Err(-5)?;
    Ok(x)
}

fn ToF64() -> Result<i32, f64> {
    let x: i32 = Err(1.5)?;
    Ok(x)
}

fn ToOption() -> Result<i32, Option<i32>> {
    let x: i32 = Err(None)?;
    Ok(x)
}

fn ToOptionU8() -> Result<i32, Option<u8>> {
    let x: i32 = Err(Some(200))?;
    Ok(x)
}

fn ToTuple() -> Result<i32, (u8, bool)> {
    let x: i32 = Err((255, true))?;
    Ok(x)
}

fn Main() {
    PrintLine(ToU8().is_err());
    PrintLine(ToI8().is_err());
    PrintLine(ToF64().is_err());
    PrintLine(ToOption().is_err());
    PrintLine(ToOptionU8().is_err());
    PrintLine(ToTuple().is_err());
}
