// `T: Into<U>` through `From<&mut Option<T>> for Option<&mut T>`: each result holds a
// mutable borrow of the option, so two at once conflict.
fn H<T: Into<U>, U>(t: T) -> U {
    t.into()
}

fn Main() {
    let mut o = Some(5);
    let r: Option<&mut i32> = H(&mut o);
    let p: Option<&mut i32> = H(&mut o);
    *r.unwrap() = 1;
    *p.unwrap() = 2;
    PrintLine(o.unwrap());
}
