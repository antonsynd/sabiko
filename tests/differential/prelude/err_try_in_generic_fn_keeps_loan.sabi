// `?` in a generic function bounded `E2: From<E>`: at `E = &i32`, `E2 = Option<&i32>`
// the converted error holds the loan.
fn F<E, E2: From<E>>(r: Result<i32, E>) -> Result<i32, E2> {
    let v = r?;
    Ok(v)
}

fn Main() {
    let mut x = 7;
    let r: Result<i32, Option<&i32>> = F(Err(&x));
    x = 8;
    PrintLine(*r.unwrap_err().unwrap());
}
