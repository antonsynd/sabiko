// An `if let` guard sees the arm's by-value binding through a reference (#98).
struct S { V: i32 }
enum H { Full(S), Empty }
enum M { Has(i32), No }
fn F(mut h: H, mut m: M, c: bool) -> i32 {
    match h { H::Full(s) if let 1 = s.V => s.V, _ => 0 }
}
fn Main() { F(H::Full(S { V: 1 }), M::Has(2), true); }
