// A move in one arm makes the scrutinee maybe-moved after the match, however the other
// arms leave it.
struct Token { Id: i32 }

enum Slot { Empty, Full(Token), Spare(Token) }

fn Consume(t: Token) {}
fn Take(s: Slot) {}

fn Main() {
    let s = Slot::Spare(Token { Id: 1 });
    match s {
        Slot::Full(t) => Consume(t),
        Slot::Spare(ref t) => PrintLine(t.Id),
        Slot::Empty => {}
    }
    Take(s);
}
