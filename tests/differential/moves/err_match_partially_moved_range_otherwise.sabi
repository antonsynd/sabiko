// A failed comparison (here the range `1..=255` after the value `0`) also ends in the
// `otherwise` block that reads the partly moved scrutinee.
struct N { A: i32 }

fn Take(n: N) {}

fn F(t: (N, u8)) -> i32 {
    Take(t.0);
    match t {
        (_, 0) => 1,
        (_, 1..=255) => 2,
    }
}

fn Main() {}
