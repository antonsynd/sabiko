// Every arm has a guard: one moves part of the scrutinee, and the next one, which the
// same values reach, gives it back before rustc's `otherwise` block reads it.
enum Void {}

struct N { A: i32 }

enum F2 { A(Void), C(Void) }

fn Mv(n: N) -> bool { false }

fn SameVariant(mut t: (N, F2)) -> i32 {
    match t {
        (_, F2::A(_)) if Mv(t.0) => 1,
        (_, F2::A(_)) if { t.0 = N { A: 1 }; false } => 2,
    }
}

fn SameBool(mut t: (N, bool, Void), c: bool) -> i32 {
    match t {
        (_, false, _) if c => 3,
        (_, true, _) if Mv(t.0) => 1,
        (_, true, _) if { t.0 = N { A: 1 }; false } => 2,
    }
}

fn Main() {}
