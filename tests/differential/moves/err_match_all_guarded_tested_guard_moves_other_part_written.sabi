// Every arm has a guard: one moves part of the scrutinee, and a later one writes another
// part, so the moved part is still moved when rustc's `otherwise` block reads it: E0382.
enum Void {}

struct N { A: i32 }

enum F2 { A(Void), C(Void) }

fn Mv(n: N) -> bool { false }

fn F(mut t: (N, N, F2), c: bool) -> i32 {
    match t {
        (_, _, F2::A(_)) if Mv(t.0) => 1,
        (_, _, F2::C(_)) if { t.1 = N { A: 1 }; c } => 2,
    }
}

fn Main() {}
