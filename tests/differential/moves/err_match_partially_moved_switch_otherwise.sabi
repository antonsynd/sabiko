// A match that lists every variant still reads its whole scrutinee where the switch on the
// discriminant fails (rustc's `otherwise` block): a partly moved one is E0382.
struct N { A: i32 }

fn Take(n: N) {}

fn F(t: (N, Option<i32>)) -> i32 {
    Take(t.0);
    match t {
        (_, Some(x)) => x,
        (_, None) => 2,
    }
}

fn Main() {}
