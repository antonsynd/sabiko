// A by-value binding of a non-Copy payload moves it out of the scrutinee: using the
// scrutinee afterwards is a use of a partially moved value.
struct Token { Id: i32 }

enum Slot { Empty, Full(Token) }

fn Consume(t: Token) {}

fn Main() {
    let s = Slot::Full(Token { Id: 1 });
    match s {
        Slot::Full(t) => Consume(t),
        Slot::Empty => {}
    }
    let again = s;
}
