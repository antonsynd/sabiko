// A guard that moves part of the scrutinee and fails, on an arm that tests the variant a
// later arm tests again: rustc's decision tree knows the variant and reaches no
// `otherwise` block after the guard, though one variant is left out as empty.
enum Void {}

struct N { A: i32 }

enum E { A(N), B(Void) }

enum F { A(i32), C(i32), B(Void) }

fn Mv(n: N) -> bool { false }

fn Same(t: (N, E)) -> i32 { match t { (_, E::A(_)) if Mv(t.0) => 1, (_, E::A(_)) => 2 } }

fn Generic(t: (N, Option<Void>)) -> i32 { match t { (_, None) if Mv(t.0) => 1, (_, None) => 2 } }

fn Other(t: (N, F)) -> i32 {
    match t { (_, F::A(_)) if Mv(t.0) => 1, (_, F::C(_)) => 3, (_, F::A(_)) => 2 }
}

fn Value(t: (N, F)) -> i32 {
    match t { (_, F::A(1)) if Mv(t.0) => 1, (_, F::A(_)) => 2, (_, F::C(_)) => 3 }
}

fn Nested(t: (N, Option<E>)) -> i32 {
    match t { (_, Some(E::A(_))) if Mv(t.0) => 1, (_, Some(E::A(_))) => 2, (_, None) => 3 }
}

fn Main() {}
