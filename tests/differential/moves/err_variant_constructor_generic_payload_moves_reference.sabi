// Without an annotation the payload type of `E::V(m, ..)` is inferred, so `m` is moved
// into it rather than reborrowed (no coercion site): reading `m.X` afterwards is a use
// after move in both compilers.
struct P { X: u8 }

enum E<T> {
    V(T, u8),
}

fn F(m: &mut P) {
    let e = E::V(m, m.X);
}

fn Main() {}
