// rustc selects before coercing these arguments into the parameter, so the bound fixes
// `A` to `i32` first: an `if`, a `match` (also as a block's value), a parenthesised or
// dereferenced value, a call, a struct literal, and blocks or loops with a call first.
//@ rustc: E0308
//@ sabiko: E0300
trait Two<A, B> {
    fn Two(&self, a: A) -> B;
}

impl<X: Copy> Two<X, X> for X {
    fn Two(&self, a: X) -> X {
        a
    }
}

#[derive(Copy, Clone)]
struct W<U> {
    V: U,
}

fn Id<U>(u: U) -> U { u }

fn If<T: Two<i32, i64> + Copy>(t: T, c: bool) -> T { Two::Two(&t, if c { t } else { t }) }
fn Match<T: Two<i32, i64> + Copy>(t: T, c: bool) -> T { Two::Two(&t, match c { _ => t }) }
fn Paren<T: Two<i32, i64> + Copy>(t: T) -> T { Two::Two(&t, (t)) }
fn Deref<T: Two<i32, i64> + Copy>(t: T) -> T { let r = &t; Two::Two(&t, *r) }
fn Call<T: Two<i32, i64> + Copy>(t: T) -> T { Two::Two(&t, Id(t)) }
fn Literal<T: Two<W<i32>, i64> + Copy>(t: T) -> W<T> { Two::Two(&t, W { V: t }) }
fn BlockIf<T: Two<i32, i64> + Copy>(t: T, c: bool) -> T { Two::Two(&t, { if c { t } else { t } }) }
fn BlockMatch<T: Two<i32, i64> + Copy>(t: T, c: bool) -> T { Two::Two(&t, { match c { _ => t } }) }
fn BlockCall<T: Two<i32, i64> + Copy>(t: T) -> T { Two::Two(&t, { Id(1); t }) }
fn LoopCall<T: Two<i32, i64> + Copy>(t: T) -> T { Two::Two(&t, loop { PrintLine(1); break t; }) }
