// Once `&t` makes `Self` a `T`, the bound fixes `A` before the second argument is checked.
//@ rustc: E0308
//@ sabiko: E0300
trait Two<A, B> {
    fn Two(&self, a: A) -> B;
}

impl<X: Copy> Two<X, X> for X {
    fn Two(&self, a: X) -> X {
        a
    }
}

fn F<T: Two<i32, i64> + Copy>(t: T) -> T {
    Two::Two(&t, t)
}
