// Open operations whose result feeds another one whose left type is known: one
// ambiguity, at the first operand, however long the chain (rustc's E0284). The result
// of each becomes an error type, so the next one is not reported again (#183).
//@ rustc: E0284
//@ sabiko: E0313
fn Mk<T>() -> T {
    Panic("x")
}

fn Pair() {
    let w = Mk();
    let x = 1u8 + w;
    let y = 1u8 + x;
}

fn Chain() {
    let w = Mk();
    let x = 1u8 + w;
    let y = 1u8 + x;
    let z = 1u8 + y;
}

fn OtherType() {
    let w = Mk();
    let x = 1u8 + w;
    let y = 1u16 * x;
}

fn BothOpen() {
    let w = Mk();
    let v = Mk();
    let x = v + w;
    let y = 1u8 + x;
}
