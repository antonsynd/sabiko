// `return` and `break` take an operand only when the next token can begin an expression
// (rustc's `can_begin_expr`); `as` cannot, so `return as i32` is `(return) as i32`, a cast
// of `!` (#50).
fn A() {
    return as i32;
}

fn B() -> i32 {
    let mut n = 0;
    loop {
        n += 1;
        if n > 2 {
            break as i64;
        }
    }
    n
}
