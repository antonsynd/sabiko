// Referents compared with `!` that are fine: a left referent that is `!` too, and right
// referents that are variables `!` was coerced to, which the left one decides (#183).
fn Mk<T>() -> T {
    Panic("x")
}

fn BothNever() {
    let x = return;
    let c = &x == &return;
}

fn BothNeverOrdered() {
    let x = return;
