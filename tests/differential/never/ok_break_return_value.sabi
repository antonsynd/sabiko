// A `loop` whose only `break` value is `return` has type `!`, which prints, or the type
// of another `break` (#183).
fn Never(c: bool) {
    let v = loop {
        if c {
            break return;
        }
    };
    PrintLine(v);
}

fn Decided(c: bool) -> u8 {
    let v = loop {
        if c {
            break return 1;
        }
        break 5u8;
    };
    v
}
