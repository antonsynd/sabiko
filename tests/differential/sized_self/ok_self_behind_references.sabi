// `Self` behind a reference needs no size: as a generic argument `&Self`, or as the
// last element of a tuple behind a reference.
struct S {}

impl S {
    fn Take<U>(&self, u: &U) -> i32 {
        1
    }
}

fn ByRef<T>(t: &T) -> i32 {
    1
}

trait Tr {
    fn A(&self) -> i32 {
        let s = S {};
        s.Take(&self) + ByRef(&self)
    }
    fn B(&self, x: &(i32, Self)) -> i32 {
        let y: &(i32, Self) = x;
        1
    }
}
