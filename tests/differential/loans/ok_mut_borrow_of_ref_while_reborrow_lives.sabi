// `d` reborrows `*m`, a place behind a shared reference: no access to `m` conflicts with
// that loan (rustc's `ignore_borrow`), so `&mut m` and a retarget through it are fine while
// `d` lives, and `d` keeps pointing at `x`. The `&str` form (`&s[1..]`) is the same.
// Found by the generator at seed 5001324 (#56).
fn Main() {
    let x = 1i32;
    let y = 2i32;
    let mut m: &i32 = &x;
    let d: &i32 = &*m;
    let a: &mut &i32 = &mut m;
    *a = &y;
    PrintLine(*d);
    PrintLine(*m);
    let mut s: &str = "abc";
    let t: &str = &s[1..];
    let u: &mut &str = &mut s;
    *u = "x";
    PrintLine(t);
    PrintLine(s);
}
