// The reservation tolerates an earlier shared borrow only until activation: using it
// after the `&mut self` call is a conflict.
struct P { X: i32 }

impl P {
    fn Get(&self) -> i32 { self.X }
    fn Add(&mut self, n: i32) { self.X += n; }
}

fn Main() {
    let mut v = P { X: 1 };
    let s = &v;
    v.Add(s.Get());
    PrintLine(s.X);
}
