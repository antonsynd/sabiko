// A struct literal is not a call: the reborrow of `m` for its field is an ordinary
// mutable borrow, so reading `m.X` for the next field conflicts (unlike `E::V(m, m.X)`).
struct P { X: u8 }

struct S<T> {
    F: T,
    G: u8,
}

fn F(m: &mut P) {
    let s: S<&mut P> = S { F: m, G: m.X };
}

fn Main() {}
