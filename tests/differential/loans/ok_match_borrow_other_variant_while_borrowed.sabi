// A loan of one variant's field does not conflict with a mutable borrow of another variant's.
enum E { A(i32), B(i32) }

fn OtherVariant(mut e: E, n: i32) -> i32 {
    let keep = 0;
    let mut r: &i32 = &keep;
    let mut i = 0;
    while i < n {
        match e {
            E::A(ref x) => r = x,
            E::B(ref mut y) => *y += 1,
        }
        i += 1;
    }
    *r
}
