// Moving a droppable value into a callee (which drops it) while a borrow of it is still
// used afterwards.
struct D { Id: i32 }

impl Drop for D {
    fn drop(&mut self) {
        PrintLine(self.Id);
    }
}

fn Consume(d: D) {}

fn Main() {
    let d = D { Id: 1 };
    let r = &d;
    Consume(d);
    PrintLine(r.Id);
}
