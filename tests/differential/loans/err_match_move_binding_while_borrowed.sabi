// Moving a payload out by binding while a shared borrow of the scrutinee is still used:
// E0505.
struct Token { Id: i32 }

enum Slot { Empty, Full(Token) }

fn Consume(t: Token) {}

fn Main() {
    let s = Slot::Full(Token { Id: 1 });
    let r = &s;
    match s {
        Slot::Full(t) => Consume(t),
        Slot::Empty => {}
    }
    let keep = r;
}
