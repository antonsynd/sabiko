// Matching `v: &mut P` tests `(*v).A` and fake-borrows `v`: retargeting it in the guard is E0510.
struct P { A: i32, B: i32 }
fn Main() {
    let mut p = P { A: 1, B: 2 };
    let mut q = P { A: 3, B: 4 };
    let mut v = &mut p;
    let x = match v { P { A: 1, .. } if { v = &mut q; false } => 1, _ => 2 };
}
