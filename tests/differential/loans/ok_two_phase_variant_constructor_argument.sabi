// A tuple variant's constructor is a call in rustc, so the implicit reborrow `&mut *m` of
// its `&mut` argument is two-phase (#145): a later argument may read through `m`, also
// inside a shared borrow that ends before the constructor runs, in a nested constructor
// and in a call's argument.
struct P { X: u8 }

enum E<T> {
    V(T, u8),
}

fn Sum(e: E<&mut P>) -> u8 {
    match e {
        E::V(r, n) => r.X + n,
    }
}

fn F(m: &mut P) -> u8 {
    let e: E<&mut P> = E::V(m, m.X);
    let f: E<&mut P> = E::V(m, { let r = &*m; r.X });
    let o: Option<E<&mut P>> = Some(E::V(m, m.X));
    Sum(E::V(m, m.X))
}

fn Main() {}
