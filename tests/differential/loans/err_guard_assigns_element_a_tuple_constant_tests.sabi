// A tuple constant in a pattern tests each of its elements, so a guard fake-borrows
// `q.0` and `q.1`: assigning `q.1` in the guard is E0510 (Sabiko E0419), as for the
// tuple pattern `(1, 2)` (#50).
const P: (i32, i32) = (1, 2);

fn Main() {
    let mut q = (1, 2);
    let r = match q {
        P if { q.1 = 3; false } => 0,
        _ => q.1,
    };
}
