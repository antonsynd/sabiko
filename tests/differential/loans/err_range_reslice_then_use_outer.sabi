// A narrower `&mut` slice reborrowed from a mutable slice keeps it borrowed: writing
// through the outer slice while the inner one is still used is E0503 (with E0506 for the
// same assignment).
fn Main() {
    let mut a = [1, 2, 3, 4];
    let m = &mut a[..];
    let n = &mut m[1..];
    m[0] = 2;
    n[0] = 1;
}
