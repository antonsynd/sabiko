// A generic trait's impl for an array names its parameter as the element type and in the
// trait: the loan of `x` that `Wrap::Wrap(&x)`'s result holds ends with its last use.
trait Wrap<T> {
    fn Wrap(t: T) -> Self;
}

impl<T> Wrap<T> for [T; 1] {
    fn Wrap(t: T) -> [T; 1] {
        [t]
    }
}

fn Main() {
    let mut x = 1;
    let w: [&i32; 1] = Wrap::Wrap(&x);
    PrintLine(*w[0]);
    x = 2;
    PrintLine(x);
}
