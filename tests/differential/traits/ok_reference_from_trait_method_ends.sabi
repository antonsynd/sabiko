// The borrow of a trait method's result ends at its last use.
trait Cell {
    fn Get(&self) -> &i32;
    fn Set(&mut self, v: i32);
}

struct Slot {
    V: i32,
}

impl Cell for Slot {
    fn Get(&self) -> &i32 {
        &self.V
    }
    fn Set(&mut self, v: i32) {
        self.V = v;
    }
}

fn Main() {
    let mut s = Slot { V: 1 };
    let r = s.Get();
    PrintLine(*r);
    s.Set(2);
}
