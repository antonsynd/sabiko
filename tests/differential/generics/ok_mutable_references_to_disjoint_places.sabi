// `&mut` of two different places in the fields of a generic struct, written through.
struct Pair<A, B> {
    First: A,
    Second: B,
}

fn Main() {
    let mut a = 1;
    let mut b = 2;
    let p = Pair { First: &mut a, Second: &mut b };
    *p.First += 10;
    *p.Second += 20;
    PrintLine(a + b);
}
