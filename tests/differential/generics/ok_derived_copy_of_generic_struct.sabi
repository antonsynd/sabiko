// `#[derive(Copy, Clone)]` on a generic struct: an instance at `Copy` arguments copies.
#[derive(Copy, Clone)]
struct Wrap<T> {
    Value: T,
}

fn Take<T>(w: Wrap<T>) -> T {
    w.Value
}

fn Main() {
    let w = Wrap { Value: 1 };
    let a = Take(w);
    let b = Take(w);
    PrintLine(a + b);
}
