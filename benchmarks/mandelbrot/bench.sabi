// Escape-time Mandelbrot over a grid: f64 arithmetic in a tight loop, int-to-float
// conversions, an early exit.

const Width: i32 = 640;
const Height: i32 = 480;
const MaxIterations: i32 = 300;

fn Escape(cr: f64, ci: f64) -> i32 {
    let mut zr = 0.0;
    let mut zi = 0.0;
    let mut i = 0;
    while i < MaxIterations {
        let zr2 = zr * zr;
        let zi2 = zi * zi;
        if zr2 + zi2 > 4.0 {
            return i;
        }
        zi = 2.0 * zr * zi + ci;
        zr = zr2 - zi2 + cr;
        i += 1;
    }
    MaxIterations
}

fn Main() {
    let mut total: i64 = 0;
    let mut inside: i32 = 0;
    let mut y = 0;
    while y < Height {
        let ci = -1.2 + 2.4 * (y as f64) / (Height as f64);
        let mut x = 0;
        while x < Width {
            let cr = -2.1 + 3.0 * (x as f64) / (Width as f64);
            let n = Escape(cr, ci);
            total += n as i64;
            if n == MaxIterations {
                inside += 1;
            }
            x += 1;
        }
        y += 1;
    }
    PrintLine(total);
    PrintLine(inside);
}
