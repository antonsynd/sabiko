// Tuples in a hot loop: a pair passed and returned by value, a division returning its
// quotient and remainder as a pair, destructuring, and a three-element accumulator rebuilt
// every iteration. The C# program uses `System.ValueTuple`, which Sabiko's tuples lower to
// (decision 52). Every intermediate stays far below 2^63, so nothing overflows in a
// checked build.

const Modulus: u64 = 1_000_000_007;
const Rounds: u64 = 20_000_000;

fn Step(state: (u64, u64)) -> (u64, u64) {
    let (a, b) = state;
    (b, (a + b) % Modulus)
}

fn DivMod(a: u64, b: u64) -> (u64, u64) {
    (a / b, a % b)
}

fn Main() {
    let mut fib = (0u64, 1u64);
    let mut acc = (0u64, 0u64, 0u64);
    let mut i: u64 = 1;
    while i <= Rounds {
        fib = Step(fib);
        let (q, r) = DivMod(fib.1, i % 97 + 1);
        acc = (acc.0 + q % 1000, acc.1 ^ r, acc.2 + 1);
        i += 1;
    }
    PrintLine(fib.0);
    PrintLine(acc.0);
    PrintLine(acc.1);
    PrintLine(acc.2);
}
